// ============================================================================ look & layout
struct Color { float r, g, b, a; };
const Color C_ACCENT = { 0.00f, 0.67f, 1.00f, 1.0f };
const Color C_WHITE = { 1.00f, 1.00f, 1.00f, 1.0f };
const Color C_DIM = { 0.68f, 0.74f, 0.80f, 1.0f };
const Color C_PANEL_TOP = { 0.02f, 0.03f, 0.06f, 0.90f };
const Color C_PANEL_BOT = { 0.00f, 0.00f, 0.00f, 0.94f };

const float HUD_SECONDS = 5.0f;   // overlay stays visible this long after the last input
const float HUD_TOP = 480.0f;     // touches below this line belong to the overlay (when visible)
const float BAR_X0 = 140.0f, BAR_X1 = 1140.0f, BAR_Y = 618.0f;
const float ROW_BTN_Y = 676.0f;
const float LIB_W = 700.0f, LIB_HEAD = 100.0f, LIB_FOOT = 56.0f, ROW_H = 54.0f;

enum { SZ_SMALL, SZ_NORMAL, SZ_TITLE, SZ_COUNT };
const int FONT_PT[SZ_COUNT] = { 20, 26, 40 };

int g_w = 1280, g_h = 720;
bool g_ready = false;

// ============================================================================ fonts
struct FontSource {
	std::string path;
	const void* data = nullptr;
	size_t size = 0;
};
std::vector<FontSource> g_sources;
std::vector<TTF_Font*> g_faces[SZ_COUNT]; // same source order in every size
int g_fontH[SZ_COUNT] = { 24, 31, 47 };

// ============================================================================ glyph / icon atlas
const int ATLAS = 2048;
GLuint g_atlasTex = 0;

struct Shelf { int y, h, x; };
std::vector<Shelf> g_shelves;
int g_nextY = 0;

struct Glyph {
	bool has = false;
	float u0 = 0, v0 = 0, u1 = 0, v1 = 0;
	int w = 0, h = 0, xoff = 0, adv = 0;
};
std::unordered_map<uint64_t, Glyph> g_glyphs;

enum Icon {
	IC_PLAY, IC_PAUSE, IC_NEXT, IC_PREV, IC_REW, IC_FFW, IC_FOLDER, IC_NOTE, IC_UP, IC_STAR,
	IC_SPEAKER, IC_SHUFFLE, IC_REPEAT, IC_REPEAT1, IC_ONCE, IC_CLOSE, IC_ALBUM, IC_ARTIST, IC_GENRE, IC_PLAYLIST, IC_BACK, IC_VIZ, IC_COUNT
};
const int ICON_PX = 64;
struct IconTex {
	float u0 = 0, v0 = 0, u1 = 0, v1 = 0;
	int ax = 0, ay = 0;               // atlas position (for re-upload after an atlas reset)
	std::vector<uint8_t> bits;        // ICON_PX*ICON_PX alpha
};
IconTex g_icons[IC_COUNT];

bool allocRect(int w, int h, int& ox, int& oy) {
	if (w > ATLAS || h > ATLAS) return false;
	int best = -1;
	for (size_t i = 0; i < g_shelves.size(); i++) {
		const Shelf& s = g_shelves[i];
		if (s.h >= h && s.h <= h + h / 2 + 4 && s.x + w <= ATLAS) {
			if (best < 0 || s.h < g_shelves[best].h) best = (int)i;
		}
	}
	if (best < 0) {
		if (g_nextY + h > ATLAS) return false;
		g_shelves.push_back({ g_nextY, h, 0 });
		g_nextY += h;
		best = (int)g_shelves.size() - 1;
	}
	Shelf& s = g_shelves[best];
	ox = s.x;
	oy = s.y;
	s.x += w;
	return true;
}

void uploadAlpha(int x, int y, int w, int h, const uint8_t* px) {
	glBindTexture(GL_TEXTURE_2D, g_atlasTex);
	glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
	glTexSubImage2D(GL_TEXTURE_2D, 0, x, y, w, h, GL_ALPHA, GL_UNSIGNED_BYTE, px);
}

// ---- polygon icons, rasterised once with 4x4 supersampling
struct Pt { float x, y; };
typedef std::vector<Pt> Poly;

bool inPoly(const Poly& p, float x, float y) {
	bool in = false;
	for (size_t i = 0, j = p.size() - 1; i < p.size(); j = i++) {
		if (((p[i].y > y) != (p[j].y > y)) &&
			(x < (p[j].x - p[i].x) * (y - p[i].y) / (p[j].y - p[i].y) + p[i].x))
			in = !in;
	}
	return in;
}

void addRect(std::vector<Poly>& s, float x0, float y0, float x1, float y1) {
	s.push_back({ {x0,y0}, {x1,y0}, {x1,y1}, {x0,y1} });
}
void addTri(std::vector<Poly>& s, float ax, float ay, float bx, float by, float cx, float cy) {
	s.push_back({ {ax,ay}, {bx,by}, {cx,cy} });
}
void addLine(std::vector<Poly>& s, float x0, float y0, float x1, float y1, float t) {
	float dx = x1 - x0, dy = y1 - y0, len = sqrtf(dx * dx + dy * dy);
	float nx = -dy / len * t * 0.5f, ny = dx / len * t * 0.5f;
	s.push_back({ {x0 + nx,y0 + ny}, {x1 + nx,y1 + ny}, {x1 - nx,y1 - ny}, {x0 - nx,y0 - ny} });
}
void addRing(std::vector<Poly>& s, float cx, float cy, float rOut, float rIn) {
	const int n = 28;
	for (int i = 0; i < n; i++) {
		const float a0 = i * 6.2831853f / n, a1 = (i + 1) * 6.2831853f / n;
		s.push_back({ {cx + cosf(a0) * rOut, cy + sinf(a0) * rOut}, {cx + cosf(a1) * rOut, cy + sinf(a1) * rOut},
			{cx + cosf(a1) * rIn, cy + sinf(a1) * rIn}, {cx + cosf(a0) * rIn, cy + sinf(a0) * rIn} });
	}
}
void addCircle(std::vector<Poly>& s, float cx, float cy, float r) {
	Poly p;
	for (int i = 0; i < 24; i++) {
		float a = i * 6.2831853f / 24.0f;
		p.push_back({ cx + cosf(a) * r, cy + sinf(a) * r });
	}
	s.push_back(p);
}

std::vector<Poly> iconShapes(Icon ic) {
	std::vector<Poly> s;
	switch (ic) {
	case IC_PLAY: addTri(s, 0.28f, 0.14f, 0.86f, 0.50f, 0.28f, 0.86f); break;
	case IC_PAUSE: addRect(s, 0.20f, 0.16f, 0.42f, 0.84f); addRect(s, 0.58f, 0.16f, 0.80f, 0.84f); break;
	case IC_NEXT: addTri(s, 0.14f, 0.20f, 0.68f, 0.50f, 0.14f, 0.80f); addRect(s, 0.72f, 0.20f, 0.86f, 0.80f); break;
	case IC_PREV: addTri(s, 0.86f, 0.20f, 0.32f, 0.50f, 0.86f, 0.80f); addRect(s, 0.14f, 0.20f, 0.28f, 0.80f); break;
	case IC_REW: addTri(s, 0.52f, 0.22f, 0.06f, 0.50f, 0.52f, 0.78f); addTri(s, 0.94f, 0.22f, 0.48f, 0.50f, 0.94f, 0.78f); break;
	case IC_FFW: addTri(s, 0.06f, 0.22f, 0.52f, 0.50f, 0.06f, 0.78f); addTri(s, 0.48f, 0.22f, 0.94f, 0.50f, 0.48f, 0.78f); break;
	case IC_FOLDER:
		addRect(s, 0.07f, 0.30f, 0.93f, 0.84f);
		s.push_back({ {0.07f,0.16f}, {0.40f,0.16f}, {0.52f,0.30f}, {0.07f,0.30f} });
		break;
	case IC_NOTE:
		addCircle(s, 0.31f, 0.74f, 0.17f);
		addRect(s, 0.42f, 0.14f, 0.54f, 0.74f);
		s.push_back({ {0.54f,0.14f}, {0.86f,0.34f}, {0.86f,0.50f}, {0.54f,0.32f} });
		break;
	case IC_UP: addTri(s, 0.50f, 0.10f, 0.14f, 0.50f, 0.86f, 0.50f); addRect(s, 0.40f, 0.46f, 0.60f, 0.90f); break;
	case IC_STAR: {
		Poly p;
		for (int i = 0; i < 10; i++) {
			float a = -1.5707963f + i * 3.14159265f / 5.0f;
			float r = (i % 2 == 0) ? 0.44f : 0.19f;
			p.push_back({ 0.5f + cosf(a) * r, 0.54f + sinf(a) * r });
		}
		s.push_back(p);
		break;
	}
	case IC_SPEAKER:
		addRect(s, 0.08f, 0.38f, 0.26f, 0.62f);
		s.push_back({ {0.26f,0.38f}, {0.52f,0.16f}, {0.52f,0.84f}, {0.26f,0.62f} });
		addRect(s, 0.62f, 0.38f, 0.69f, 0.62f);
		addRect(s, 0.76f, 0.26f, 0.83f, 0.74f);
		break;
	case IC_SHUFFLE:
		addLine(s, 0.06f, 0.26f, 0.52f, 0.74f, 0.10f); addLine(s, 0.06f, 0.74f, 0.52f, 0.26f, 0.10f);
		addLine(s, 0.48f, 0.74f, 0.78f, 0.74f, 0.10f); addLine(s, 0.48f, 0.26f, 0.78f, 0.26f, 0.10f);
		addTri(s, 0.76f, 0.58f, 0.96f, 0.74f, 0.76f, 0.90f); addTri(s, 0.76f, 0.10f, 0.96f, 0.26f, 0.76f, 0.42f);
		break;
	case IC_REPEAT:
	case IC_REPEAT1:
		addLine(s, 0.18f, 0.30f, 0.70f, 0.30f, 0.10f); addLine(s, 0.82f, 0.36f, 0.82f, 0.62f, 0.10f);
		addLine(s, 0.30f, 0.70f, 0.82f, 0.70f, 0.10f); addLine(s, 0.18f, 0.38f, 0.18f, 0.64f, 0.10f);
		addTri(s, 0.66f, 0.12f, 0.94f, 0.30f, 0.66f, 0.48f); addTri(s, 0.34f, 0.52f, 0.06f, 0.70f, 0.34f, 0.88f);
		if (ic == IC_REPEAT1) {
			addRect(s, 0.47f, 0.38f, 0.55f, 0.64f);
			addTri(s, 0.38f, 0.46f, 0.47f, 0.38f, 0.47f, 0.50f);
		}
		break;
	case IC_ONCE:
		addLine(s, 0.08f, 0.50f, 0.58f, 0.50f, 0.12f);
		addTri(s, 0.52f, 0.26f, 0.84f, 0.50f, 0.52f, 0.74f);
		addRect(s, 0.88f, 0.26f, 0.96f, 0.74f);
		break;
	case IC_ALBUM: // a disc
		addRing(s, 0.5f, 0.5f, 0.44f, 0.15f);
		break;
	case IC_ARTIST: { // head and shoulders
		addCircle(s, 0.5f, 0.28f, 0.18f);
		Poly body;
		for (int i = 0; i <= 14; i++) {
			const float a = 3.14159265f + i * 3.14159265f / 14.0f; // upper half circle
			body.push_back({ 0.5f + cosf(a) * 0.38f, 0.92f + sinf(a) * 0.40f });
		}
		s.push_back(body);
		break;
	}
	case IC_GENRE: // a tag
		s.push_back({ {0.08f,0.50f}, {0.36f,0.18f}, {0.92f,0.18f}, {0.92f,0.82f}, {0.36f,0.82f} });
		break;
	case IC_PLAYLIST: // list lines with a small play arrow
		addRect(s, 0.08f, 0.18f, 0.62f, 0.30f); addRect(s, 0.08f, 0.44f, 0.62f, 0.56f); addRect(s, 0.08f, 0.70f, 0.46f, 0.82f);
		addTri(s, 0.70f, 0.40f, 0.94f, 0.64f, 0.70f, 0.88f);
		break;
	case IC_BACK: // arrow pointing left
		addTri(s, 0.10f, 0.50f, 0.46f, 0.14f, 0.46f, 0.86f); addRect(s, 0.40f, 0.42f, 0.92f, 0.58f);
		break;
	case IC_VIZ: // equaliser bars
		addRect(s, 0.12f, 0.48f, 0.30f, 0.88f); addRect(s, 0.41f, 0.14f, 0.59f, 0.88f); addRect(s, 0.70f, 0.58f, 0.88f, 0.88f);
		break;
	case IC_CLOSE:
		addLine(s, 0.20f, 0.20f, 0.80f, 0.80f, 0.14f); addLine(s, 0.80f, 0.20f, 0.20f, 0.80f, 0.14f);
		break;
	default: break;
	}
	return s;
}

void rasterIcon(Icon ic) {
	IconTex& t = g_icons[ic];
	t.bits.assign(ICON_PX * ICON_PX, 0);
	std::vector<Poly> shapes = iconShapes(ic);
	const int SS = 4;
	for (int y = 0; y < ICON_PX; y++) {
		for (int x = 0; x < ICON_PX; x++) {
			int hits = 0;
			for (int sy = 0; sy < SS; sy++) {
				for (int sx = 0; sx < SS; sx++) {
					float fx = (x + (sx + 0.5f) / SS) / ICON_PX;
					float fy = (y + (sy + 0.5f) / SS) / ICON_PX;
					for (const Poly& p : shapes) {
						if (inPoly(p, fx, fy)) { hits++; break; }
					}
				}
			}
			t.bits[y * ICON_PX + x] = (uint8_t)(hits * 255 / (SS * SS));
		}
	}
}

void placeIcon(Icon ic) {
	IconTex& t = g_icons[ic];
	const int cell = ICON_PX + 2;
	int ox, oy;
	if (!allocRect(cell, cell, ox, oy)) return;
	std::vector<uint8_t> buf(cell * cell, 0);
	for (int y = 0; y < ICON_PX; y++) memcpy(&buf[(y + 1) * cell + 1], &t.bits[y * ICON_PX], ICON_PX);
	uploadAlpha(ox, oy, cell, cell, buf.data());
	t.ax = ox + 1;
	t.ay = oy + 1;
	t.u0 = (float)t.ax / ATLAS;
	t.v0 = (float)t.ay / ATLAS;
	t.u1 = (float)(t.ax + ICON_PX) / ATLAS;
	t.v1 = (float)(t.ay + ICON_PX) / ATLAS;
}

void resetAtlas() {
	printf("UI: glyph atlas full, resetting\n");
	g_glyphs.clear();
	g_shelves.clear();
	g_nextY = 0;
	std::vector<uint8_t> zero((size_t)ATLAS * ATLAS, 0);
	uploadAlpha(0, 0, ATLAS, ATLAS, zero.data());
	for (int i = 0; i < IC_COUNT; i++) placeIcon((Icon)i);
}

// ============================================================================ text
std::vector<uint32_t> decodeUtf8(const std::string& s) {
	std::vector<uint32_t> out;
	size_t i = 0, n = s.size();
	while (i < n) {
		unsigned char c = (unsigned char)s[i];
		uint32_t cp = c;
		int len = 1;
		if (c >= 0xF0 && c < 0xF8) { cp = c & 0x07; len = 4; }
		else if (c >= 0xE0) { cp = c & 0x0F; len = 3; }
		else if (c >= 0xC0) { cp = c & 0x1F; len = 2; }
		else if (c >= 0x80) { len = 1; } // stray continuation byte -> treat as Latin-1
		bool ok = (i + len <= n);
		if (ok && len > 1) {
			for (int k = 1; k < len; k++) {
				unsigned char cc = (unsigned char)s[i + k];
				if ((cc & 0xC0) != 0x80) { ok = false; break; }
				cp = (cp << 6) | (cc & 0x3F);
			}
		}
		if (!ok || (len > 1 && cp < 0x80)) { cp = c; len = 1; } // invalid: Latin-1 fallback
		out.push_back(cp);
		i += len;
	}
	return out;
}

bool glyphProvided(TTF_Font* f, uint32_t cp) {
#ifdef UI_TTF32
	return TTF_GlyphIsProvided32(f, cp) != 0;
#else
	return cp <= 0xFFFF && TTF_GlyphIsProvided(f, (Uint16)cp) != 0;
#endif
}

SDL_Surface* renderGlyph(TTF_Font* f, uint32_t cp) {
	const SDL_Color white = { 255, 255, 255, 255 };
#ifdef UI_TTF32
	return TTF_RenderGlyph32_Blended(f, cp, white);
#else
	return cp <= 0xFFFF ? TTF_RenderGlyph_Blended(f, (Uint16)cp, white) : nullptr;
#endif
}

void glyphMetrics(TTF_Font* f, uint32_t cp, int& minx, int& adv) {
	int maxx = 0, miny = 0, maxy = 0;
#ifdef UI_TTF32
	if (TTF_GlyphMetrics32(f, cp, &minx, &maxx, &miny, &maxy, &adv) != 0) { minx = 0; adv = FONT_PT[SZ_NORMAL] / 2; }
#else
	if (TTF_GlyphMetrics(f, (Uint16)cp, &minx, &maxx, &miny, &maxy, &adv) != 0) { minx = 0; adv = FONT_PT[SZ_NORMAL] / 2; }
#endif
}

Glyph& glyph(int sz, uint32_t cp) {
	const uint64_t key = ((uint64_t)sz << 32) | cp;
	auto it = g_glyphs.find(key);
	if (it != g_glyphs.end()) return it->second;

	Glyph g;
	TTF_Font* font = nullptr;
	for (TTF_Font* f : g_faces[sz]) {
		if (glyphProvided(f, cp)) { font = f; break; }
	}
	if (!font) {
		if (cp != '?') { // not in any font: show a question mark
			Glyph& q = glyph(sz, '?');
			return g_glyphs[key] = q;
		}
		font = g_faces[sz].empty() ? nullptr : g_faces[sz][0];
	}
	if (font) {
		int minx = 0, adv = 0;
		glyphMetrics(font, cp, minx, adv);
		g.adv = adv;
		SDL_Surface* raw = renderGlyph(font, cp);
		if (raw) {
			SDL_Surface* s = raw;
			if (raw->format->BytesPerPixel != 4) s = SDL_ConvertSurfaceFormat(raw, SDL_PIXELFORMAT_ARGB8888, 0);
			if (s && s->w > 0 && s->h > 0) {
				const int cw = s->w + 2, ch = s->h + 2;
				int ox, oy;
				if (!allocRect(cw, ch, ox, oy)) {
					resetAtlas();
					if (!allocRect(cw, ch, ox, oy)) ox = oy = -1;
				}
				if (ox >= 0) {
					std::vector<uint8_t> buf((size_t)cw * ch, 0);
					for (int y = 0; y < s->h; y++) {
						const uint8_t* row = (const uint8_t*)s->pixels + (size_t)y * s->pitch;
						for (int x = 0; x < s->w; x++) {
							Uint32 px = *(const Uint32*)(row + x * 4);
							buf[(size_t)(y + 1) * cw + x + 1] = (uint8_t)((px & s->format->Amask) >> s->format->Ashift);
						}
					}
					uploadAlpha(ox, oy, cw, ch, buf.data());
					g.has = true;
					g.w = s->w;
					g.h = s->h;
					g.xoff = minx < 0 ? minx : 0;
					g.u0 = (float)(ox + 1) / ATLAS;
					g.v0 = (float)(oy + 1) / ATLAS;
					g.u1 = (float)(ox + 1 + s->w) / ATLAS;
					g.v1 = (float)(oy + 1 + s->h) / ATLAS;
				}
			}
			if (s != raw) SDL_FreeSurface(s);
			SDL_FreeSurface(raw);
		}
	}
	return g_glyphs[key] = g;
}

float cpsWidth(int sz, const std::vector<uint32_t>& cps, size_t from, size_t to) {
	float w = 0;
	for (size_t i = from; i < to; i++) w += glyph(sz, cps[i]).adv;
	return w;
}

float textWidth(int sz, const std::string& s) {
	std::vector<uint32_t> cps = decodeUtf8(s);
	return cpsWidth(sz, cps, 0, cps.size());
}

// ============================================================================ batching
// vertex: pos(2) uv(2) color(4) shape(4: local xy, half size xy) param(2: radius, kind)
// kind 0 = atlas (text, icons), 1 = rounded rect, 2 = rounded rect textured with the cover art
const int VERT_FLOATS = 14;
std::vector<float> g_v;
float g_alpha = 1.0f; // global fade multiplier
GLuint g_prog = 0, g_vbo = 0;
GLint g_uAtlas = -1, g_uCover = -1;
GLuint g_coverTex = 0; // cover art texture of the info panel (0 = none)

void pv(float x, float y, float u, float v, Color c,
	float lx, float ly, float hx, float hy, float rad, float kind) {
	g_v.push_back(x / g_w * 2.0f - 1.0f);
	g_v.push_back(1.0f - y / g_h * 2.0f);
	g_v.push_back(u); g_v.push_back(v);
	g_v.push_back(c.r); g_v.push_back(c.g); g_v.push_back(c.b); g_v.push_back(c.a * g_alpha);
	g_v.push_back(lx); g_v.push_back(ly); g_v.push_back(hx); g_v.push_back(hy);
	g_v.push_back(rad); g_v.push_back(kind);
}

void rrectGrad(float x, float y, float w, float h, float r, Color top, Color bot) {
	if (w <= 0 || h <= 0) return;
	const float hw = w * 0.5f, hh = h * 0.5f;
	r = fminf(r, fminf(hw, hh));
	const float p = 1.0f; // feather margin
	struct V { float x, y; Color c; };
	const V q[4] = {
		{ x - p,     y - p,     top }, { x + w + p, y - p,     top },
		{ x - p,     y + h + p, bot }, { x + w + p, y + h + p, bot } };
	const int order[6] = { 0, 1, 2, 1, 3, 2 };
	for (int k = 0; k < 6; k++) {
		const V& v = q[order[k]];
		pv(v.x, v.y, 0, 0, v.c, (v.x - (x + hw)), (v.y - (y + hh)), hw, hh, r, 1.0f);
	}
}
void rrect(float x, float y, float w, float h, float r, Color c) { rrectGrad(x, y, w, h, r, c, c); }
void coverQuad(float x, float y, float w, float h, float r) {
	const float hw = w * 0.5f, hh = h * 0.5f;
	r = fminf(r, fminf(hw, hh));
	const float p = 1.0f;
	const float xs[4] = { x - p, x + w + p, x - p, x + w + p }, ys[4] = { y - p, y - p, y + h + p, y + h + p };
	const int order[6] = { 0, 1, 2, 1, 3, 2 };
	for (int k = 0; k < 6; k++) {
		const float vx = xs[order[k]], vy = ys[order[k]];
		pv(vx, vy, (vx - x) / w, (vy - y) / h, { 1, 1, 1, 1 }, vx - (x + hw), vy - (y + hh), hw, hh, r, 2.0f);
	}
}
void circle(float cx, float cy, float rad, Color c) { rrect(cx - rad, cy - rad, rad * 2, rad * 2, rad, c); }

void quadTex(float x, float y, float w, float h, float u0, float v0, float u1, float v1, Color c) {
	const float xs[4] = { x, x + w, x, x + w }, ys[4] = { y, y, y + h, y + h };
	const float us[4] = { u0, u1, u0, u1 }, vs[4] = { v0, v0, v1, v1 };
	const int order[6] = { 0, 1, 2, 1, 3, 2 };
	for (int k = 0; k < 6; k++) pv(xs[order[k]], ys[order[k]], us[order[k]], vs[order[k]], c, 0, 0, 0, 0, 0, 0.0f);
}

void drawIcon(Icon ic, float cx, float cy, float size, Color c) {
	const IconTex& t = g_icons[ic];
	quadTex(cx - size * 0.5f, cy - size * 0.5f, size, size, t.u0, t.v0, t.u1, t.v1, c);
}

enum Align { LEFT, CENTER, RIGHT };

// Draws text; if maxW > 0 the text is cut with "..." (keepTail: keep the end, e.g. for paths). Returns drawn width.
float drawText(int sz, float x, float y, const std::string& s, Color c, float maxW = 0, Align al = LEFT, bool keepTail = false) {
	if (s.empty() || g_faces[sz].empty()) return 0;
	std::vector<uint32_t> cps = decodeUtf8(s);
	float total = cpsWidth(sz, cps, 0, cps.size());
	std::vector<uint32_t> use;
	if (maxW > 0 && total > maxW) {
		const float dots = 3 * glyph(sz, '.').adv;
		size_t keep = 0;
		float w = 0;
		if (!keepTail) {
			while (keep < cps.size() && w + glyph(sz, cps[keep]).adv + dots <= maxW) w += glyph(sz, cps[keep++]).adv;
			use.assign(cps.begin(), cps.begin() + keep);
			use.insert(use.end(), 3, (uint32_t)'.');
		}
		else {
			while (keep < cps.size() && w + glyph(sz, cps[cps.size() - 1 - keep]).adv + dots <= maxW) w += glyph(sz, cps[cps.size() - 1 - keep++]).adv;
			use.assign(3, (uint32_t)'.');
			use.insert(use.end(), cps.end() - keep, cps.end());
		}
		total = w + dots;
	}
	else {
		use = cps;
	}
	if (al == CENTER) x -= total * 0.5f;
	else if (al == RIGHT) x -= total;
	float pen = roundf(x);
	const float ty = roundf(y);
	for (uint32_t cp : use) {
		const Glyph& g = glyph(sz, cp);
		if (g.has) quadTex(pen + g.xoff, ty, (float)g.w, (float)g.h, g.u0, g.v0, g.u1, g.v1, c);
		pen += g.adv;
	}
	return total;
}

Color withA(Color c, float a) { c.a *= a; return c; }

std::string fmtTime(double t) {
	if (t < 0) t = 0;
	int s = (int)t, h = s / 3600, m = (s / 60) % 60, sec = s % 60;
	char buf[32];
	if (h > 0) snprintf(buf, sizeof(buf), "%d:%02d:%02d", h, m, sec);
	else snprintf(buf, sizeof(buf), "%d:%02d", m, sec);
	return buf;
}

const char* VS = R"(
attribute vec2 aPos;
attribute vec2 aUV;
attribute vec4 aCol;
attribute vec4 aShape;
attribute vec2 aParam;
varying vec2 vUV;
varying vec4 vCol;
varying vec4 vShape;
varying vec2 vParam;
void main() {
    vUV = aUV; vCol = aCol; vShape = aShape; vParam = aParam;
    gl_Position = vec4(aPos, 0.0, 1.0);
}
)";

const char* FS = R"(
precision mediump float;
uniform sampler2D uAtlas;
uniform sampler2D uCover;
varying vec2 vUV;
varying vec4 vCol;
varying vec4 vShape;
varying vec2 vParam;
void main() {
    vec3 rgb = vCol.rgb;
    float a;
    if (vParam.y < 0.5) {
        a = texture2D(uAtlas, vUV).a;
    } else {
        vec2 q = abs(vShape.xy) - (vShape.zw - vParam.x);
        float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - vParam.x;
        a = clamp(0.5 - d, 0.0, 1.0);
        if (vParam.y > 1.5) rgb = texture2D(uCover, vUV).rgb;
    }
    a *= vCol.a;
    gl_FragColor = vec4(rgb * a, a);
}
)";

GLuint compile(GLenum type, const char* src) {
	GLuint s = glCreateShader(type);
	glShaderSource(s, 1, &src, NULL);
	glCompileShader(s);
	GLint ok = 0;
	glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
	if (!ok) {
		char log[1024];
		glGetShaderInfoLog(s, sizeof(log), NULL, log);
		printf("UI shader compile error: %s\n", log);
		glDeleteShader(s);
		return 0;
	}
	return s;
}

void flush() {
	if (g_v.empty()) return;
	const GLsizei stride = VERT_FLOATS * sizeof(float);
	glUseProgram(g_prog);
	glEnable(GL_BLEND);
	glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA); // premultiplied alpha
	glActiveTexture(GL_TEXTURE0);
	glBindTexture(GL_TEXTURE_2D, g_atlasTex);
	glUniform1i(g_uAtlas, 0);
	glActiveTexture(GL_TEXTURE1);
	glBindTexture(GL_TEXTURE_2D, g_coverTex ? g_coverTex : g_atlasTex); // always a valid texture
	glUniform1i(g_uCover, 1);
	glActiveTexture(GL_TEXTURE0);
	glBindBuffer(GL_ARRAY_BUFFER, g_vbo);
	glBufferData(GL_ARRAY_BUFFER, g_v.size() * sizeof(float), g_v.data(), GL_STREAM_DRAW);
	glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, stride, (void*)(0 * sizeof(float)));
	glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, stride, (void*)(2 * sizeof(float)));
	glVertexAttribPointer(2, 4, GL_FLOAT, GL_FALSE, stride, (void*)(4 * sizeof(float)));
	glVertexAttribPointer(3, 4, GL_FLOAT, GL_FALSE, stride, (void*)(8 * sizeof(float)));
	glVertexAttribPointer(4, 2, GL_FLOAT, GL_FALSE, stride, (void*)(12 * sizeof(float)));
	for (int a = 0; a < 5; a++) glEnableVertexAttribArray(a);
	glDrawArrays(GL_TRIANGLES, 0, (GLsizei)(g_v.size() / VERT_FLOATS));
	for (int a = 1; a < 5; a++) glDisableVertexAttribArray(a); // attribute 0 stays enabled for the shader quad
	glDisable(GL_BLEND);
	glBindBuffer(GL_ARRAY_BUFFER, 0);
	g_v.clear();
}

// ============================================================================ interaction state
enum Target {
	T_NONE = 0, T_PREV, T_REW, T_PLAY, T_FFW, T_NEXT, T_LIB, T_MODE, T_SEEK, T_VOL, T_INFO, T_AUTO,
	T_LIST, T_CLOSE, T_HOME, T_MENU, T_OUTSIDE
};

struct HitBox { Target id; float x0, y0, x1, y1; };
const HitBox HUD_BOXES[] = {
	{ T_SEEK, BAR_X0 - 24, BAR_Y - 26, BAR_X1 + 24, BAR_Y + 26 },
	{ T_VOL,  1010, ROW_BTN_Y - 26, 1240, ROW_BTN_Y + 26 },
	{ T_MODE, 1150, 500, 1235, 565 },
	{ T_INFO, 40, 488, 1060, 585 },     // tap the title for track info
	{ T_INFO, 1160, 568, 1235, 606 },   // the (i) chip
	{ T_AUTO, 1100, 566, 1156, 592 },   // auto-change visualisation chip
	{ T_LIB,  50, ROW_BTN_Y - 36, 260, ROW_BTN_Y + 36 },
	{ T_PREV, 470 - 40, ROW_BTN_Y - 40, 470 + 40, ROW_BTN_Y + 40 },
	{ T_REW,  560 - 40, ROW_BTN_Y - 40, 560 + 40, ROW_BTN_Y + 40 },
	{ T_PLAY, 650 - 48, ROW_BTN_Y - 44, 650 + 48, ROW_BTN_Y + 44 },
	{ T_FFW,  740 - 40, ROW_BTN_Y - 40, 740 + 40, ROW_BTN_Y + 40 },
	{ T_NEXT, 830 - 40, ROW_BTN_Y - 40, 830 + 40, ROW_BTN_Y + 40 },
};
const float VOL_X0 = 1075, VOL_X1 = 1220;

bool inBox(const HitBox& b, float x, float y) { return x >= b.x0 && x <= b.x1 && y >= b.y0 && y <= b.y1; }

Target hudTargetAt(float x, float y) {
	for (const HitBox& b : HUD_BOXES) if (inBox(b, x, y)) return b.id;
	return T_NONE;
}

float g_hudTimer = 0.0f, g_hudAlpha = 0.0f;
uint32_t g_lastTrackChange = 0;

// touch gesture state
bool g_prevTouching = false;
bool g_touchOwned = false;       // the current touch belongs to the UI
Target g_touchTarget = T_NONE;
float g_touchSX = 0, g_touchSY = 0, g_touchLX = 0, g_touchLY = 0;
bool g_touchMoved = false;
float g_seekFrac = 0.0f;         // while dragging the progress bar

// toast
std::string g_toast;
float g_toastTimer = 0.0f;

// key repeat
struct Repeater {
	float t = 0.0f;
	bool fire(bool down, bool held, float dt, float first = 0.35f, float rep = 0.075f) {
		if (down) { t = first; return true; }
		if (!held) { t = 0; return false; }
		t -= dt;
		if (t <= 0) { t = rep; return true; }
		return false;
	}
};
Repeater g_repUp, g_repDown, g_repVol, g_repPgUp, g_repPgDown;

// ============================================================================ library
enum RowKind {
	R_UP, R_PLAYDIR, R_SETDIR, R_DIR, R_FILE,                                   // folder browser
	R_BACK, R_PLAYALL, R_TRACK, R_ALBUM, R_ARTIST, R_GENRE, R_PLAYLIST, R_SAVEQUEUE, R_DELPLAYLIST, R_NEWPLAYLIST, R_PICKPLAYLIST, R_RENAMEPLAYLIST, // library views
	R_HOME_FOLDERS, R_HOME_ALBUMS, R_HOME_ARTISTS, R_HOME_GENRES, R_HOME_PLAYLISTS, R_HOME_ALL, R_HOME_AUTO, R_HOME_RESCAN, R_HOME_RESUME, R_HOME_SLEEP, R_HOME_SLEEPACT
};
enum PageKind { PG_FOLDERS, PG_HOME, PG_ALBUMS, PG_ARTISTS, PG_GENRES, PG_PLAYLISTS, PG_ALL, PG_ALBUM, PG_ARTIST, PG_GENRE, PG_PLAYLIST, PG_PICKLIST };

struct Row {
	RowKind kind;
	std::string label;
	std::string path;
	std::string sub;   // dim text on the right (counts, artist...)
	int ref = -1;      // R_TRACK: index in View::trackPaths, R_ALBUM/R_ARTIST/R_GENRE: index in View::groups
};

struct View {
	PageKind kind = PG_HOME;
	std::string title, subtitle, emptyMsg;
	std::vector<Row> rows;
	int sel = 0;
	float scroll = 0.0f, scrollDisp = 0.0f;
	bool empty = false;
	std::vector<std::string> trackPaths;             // what R_TRACK / R_PLAYALL play
	std::vector<library::Group> groups;              // what R_ALBUM / R_ARTIST / R_GENRE open
	std::shared_ptr<const library::Snapshot> snap;   // keeps the data behind 'groups' alive
	uint32_t builtVersion = 0;                       // home page: refresh when the library changes
	int builtDone = -1;
	bool dirty = false;                              // home page: rebuild on the next frame
	bool builtScanning = false;
	int plCount = 0;
	std::string playlistPath;                        // playlist page: the .m3u file (for deleting it)
	bool confirmDelete = false;                      // playlist page: 'delete' was pressed once
};

enum LibMode { M_MENU, M_FOLDERS, M_PICK }; // M_PICK: the 'add to playlist' page, shown over either of the others
struct Library {
	bool open = false;
	float slide = 0.0f;
	LibMode mode = M_MENU;
	View pick;                        // 'add to playlist' page
	LibMode pickReturn = M_MENU;      // where to go back to afterwards
	std::string dir;                  // folder browser: current folder
	View folder;                      // folder browser: its rows
	std::vector<View> stack;          // menu pages; stack[0] is the home page
	std::unordered_map<std::string, std::pair<int, float>> memo; // folder browser: selection per folder
} g_lib;

View& cur() {
	if (g_lib.mode == M_PICK) return g_lib.pick;
	if (g_lib.mode == M_FOLDERS) return g_lib.folder;
	if (g_lib.stack.empty()) { static View none; return none; }
	return g_lib.stack.back();
}

float listTop() { return LIB_HEAD; }
float listBottom() { return (float)g_h - LIB_FOOT; }
float listHeight() { return listBottom() - listTop(); }
float maxScroll(const View& v) { return fmaxf(0.0f, v.rows.size() * ROW_H - listHeight()); }

void clampScroll(View& v) { v.scroll = fminf(fmaxf(v.scroll, 0.0f), maxScroll(v)); }

void ensureVisible(View& v) {
	const float top = v.sel * ROW_H, bot = top + ROW_H;
	if (top < v.scroll) v.scroll = top;
	else if (bot > v.scroll + listHeight()) v.scroll = bot - listHeight();
	clampScroll(v);
}

void showToast(const std::string& t) { g_toast = t; g_toastTimer = 2.4f; }

// ---- auto-change visualisation: Off -> 30 s -> 45 s -> 60 s -> 2 min -> Off
const int AUTO_STEPS[] = { 0, 30, 45, 60, 120 };
int g_autoSecs = 0;

std::string autoLabel() {
	if (g_autoSecs == 0) return "off";
	if (g_autoSecs >= 120) return "every " + std::to_string(g_autoSecs / 60) + " min";
	return "every " + std::to_string(g_autoSecs) + " s";
}

// ---- sleep timer: Off -> 15 -> 30 -> 45 -> 60 -> 90 min -> after this track -> Off
const int SLEEP_STEPS[] = { 0, 15, 30, 45, 60, 90, player::SLEEP_END_OF_TRACK };
int g_sleepStep = 0;             // the option picked last (minutes), for cycling
float g_quitCountdown = 0.0f;      // > 0: the app is about to close because the sleep timer ended
bool g_mediaStateReleased = false; // true while we have told the system it may go to sleep

std::string sleepLabel() {
	if (!player::sleepActive()) return "off";
	if (player::sleepAtTrackEnd()) return "pauses after this track";
	if (player::sleepFading()) return "fading out...";
	const int mins = (player::sleepSecondsLeft() + 59) / 60;
	return std::to_string(mins) + (mins == 1 ? " minute left" : " minutes left");
}

void cycleSleep() {
	int idx = 0;
	if (player::sleepActive())
		for (int i = 0; i < (int)(sizeof(SLEEP_STEPS) / sizeof(SLEEP_STEPS[0])); i++) if (SLEEP_STEPS[i] == g_sleepStep) idx = i;
	idx = (idx + 1) % (int)(sizeof(SLEEP_STEPS) / sizeof(SLEEP_STEPS[0]));
	g_sleepStep = SLEEP_STEPS[idx];
	player::setSleepTimer(g_sleepStep);
	if (g_sleepStep == 0) showToast("Sleep timer: off");
	else if (g_sleepStep < 0) showToast("Sleep timer: the music pauses after this track");
	else showToast("Sleep timer: " + std::to_string(g_sleepStep) + " minutes");
}

void cycleAuto() {
	int idx = 0;
	for (int i = 0; i < (int)(sizeof(AUTO_STEPS) / sizeof(AUTO_STEPS[0])); i++) if (AUTO_STEPS[i] == g_autoSecs) idx = i;
	idx = (idx + 1) % (int)(sizeof(AUTO_STEPS) / sizeof(AUTO_STEPS[0]));
	g_autoSecs = AUTO_STEPS[idx];
	player::setConfigInt("auto_cycle", g_autoSecs);
	showToast("Auto-change visualisation: " + autoLabel());
}

// ---- folder browser
void buildRows(const std::string& selectPath) {
	View& f = g_lib.folder;
	f.kind = PG_FOLDERS;
	f.title = "Folders";
	f.emptyMsg = "No folders or music files here";
	f.rows.clear();
	const std::string par = player::parentPath(g_lib.dir);
	if (!par.empty()) f.rows.push_back({ R_UP, "Up one folder", par, "" });
	f.rows.push_back({ R_PLAYDIR, "Play this folder", g_lib.dir, "" });
	const bool isMusicFolder = (g_lib.dir == player::musicFolder());
	f.rows.push_back({ R_SETDIR, isMusicFolder ? "This is your music folder" : "Set as music folder", g_lib.dir, "" });
	const size_t firstEntry = f.rows.size();
	std::vector<player::DirEntry> entries = player::listDirectory(g_lib.dir);
	for (const player::DirEntry& e : entries) f.rows.push_back({ e.isDir ? R_DIR : R_FILE, e.name, e.path, "" });
	f.empty = entries.empty();

	auto it = g_lib.memo.find(g_lib.dir);
	if (it != g_lib.memo.end()) {
		f.sel = std::min(it->second.first, (int)f.rows.size() - 1);
		f.scroll = it->second.second;
	}
	else {
		f.sel = (int)(firstEntry < f.rows.size() ? firstEntry : (f.rows.size() - 1));
		f.scroll = 0;
	}
	if (!selectPath.empty()) {
		for (size_t i = 0; i < f.rows.size(); i++) {
			if (f.rows[i].path == selectPath && f.rows[i].kind != R_UP) { f.sel = (int)i; break; }
		}
	}
	clampScroll(f);
	ensureVisible(f);
	f.scrollDisp = f.scroll;
}

void libEnter(const std::string& dir, const std::string& selectPath = "") {
	if (!g_lib.dir.empty()) g_lib.memo[g_lib.dir] = { g_lib.folder.sel, g_lib.folder.scroll };
	g_lib.dir = dir;
	buildRows(selectPath);
}

// ---- library views (albums, artists, genres, playlists...)
std::string plural(size_t n, const char* one, const char* many) {
	return std::to_string(n) + " " + (n == 1 ? one : many);
}

std::string pad2(int n) {
	char b[16];
	snprintf(b, sizeof(b), "%02d", n);
	return b;
}

struct Item {
	std::string path, label, sub;
};

std::string lowerStr(std::string s) {
	std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return (char)tolower(c); });
	return s;
}

// style 0: "03  Title"   style 1: title + album   style 2: title + artist
std::vector<Item> itemsFromTracks(const library::Snapshot& s, const std::vector<int>& idx, int style) {
	std::vector<Item> out;
	out.reserve(idx.size());
	for (int i : idx) {
		const library::Track& t = s.tracks[i];
		Item it;
		it.path = t.path;
		const std::string title = library::displayTitle(t);
		it.label = (style == 0 && t.trackNo > 0) ? pad2(t.trackNo) + "  " + title : title;
		if (style == 1) it.sub = library::albumDisplayName(t);
		else if (style == 2) it.sub = t.artist.empty() ? t.albumArtist : t.artist;
		out.push_back(std::move(it));
	}
	return out;
}

View makeTrackView(PageKind kind, const std::string& title, const std::string& subtitle,
	const std::vector<Item>& items, const std::string& playLabel, std::shared_ptr<const library::Snapshot> snap) {
	View v;
	v.kind = kind;
	v.title = title;
	v.subtitle = subtitle;
	v.snap = snap;
	v.empty = items.empty();
	v.emptyMsg = "No playable tracks here";
	v.rows.push_back({ R_BACK, "Back", "", "" });
	v.rows.push_back({ R_PLAYALL, playLabel, "", "" });
	for (size_t i = 0; i < items.size(); i++) {
		v.rows.push_back({ R_TRACK, items[i].label, items[i].path, items[i].sub, (int)i });
		v.trackPaths.push_back(items[i].path);
	}
	v.sel = items.empty() ? 1 : 2;
	return v;
}

View makeHome(int plCount) {
	View v;
	v.kind = PG_HOME;
	v.title = "Library";
	v.snap = library::snapshot();
	v.builtVersion = library::version();
	v.builtDone = library::scanDone();
	v.builtScanning = library::scanning();
	v.plCount = plCount;
	const library::Snapshot& s = *v.snap;
	const bool scan = library::scanning();
	v.rows.push_back({ R_HOME_FOLDERS, "Folders", "", "browse the SD card" });
	v.rows.push_back({ R_HOME_ALBUMS, "Albums", "", std::to_string(s.albums.size()) });
	v.rows.push_back({ R_HOME_ARTISTS, "Artists", "", std::to_string(s.artists.size()) });
	v.rows.push_back({ R_HOME_GENRES, "Genres", "", std::to_string(s.genres.size()) });
	v.rows.push_back({ R_HOME_PLAYLISTS, "Playlists", "", std::to_string(plCount) });
	v.rows.push_back({ R_HOME_ALL, "All songs", "", std::to_string(s.tracks.size()) });
	v.rows.push_back({ R_HOME_AUTO, "Auto-change visualisation", "", autoLabel() });
	v.rows.push_back({ R_HOME_SLEEP, "Sleep timer", "", sleepLabel() });
	if (player::sleepActive()) // only relevant while a sleep timer is running
	v.rows.push_back({ R_HOME_SLEEPACT, "When the sleep timer ends", "", player::configInt("sleep_quit", 1) ? "close the app" : "pause only" });
	v.rows.push_back({ R_HOME_RESUME, "Resume on launch", "", player::configInt("resume_play", 0) ? "keeps playing" : "starts paused" });
	v.rows.push_back({ R_HOME_RESCAN, "Rescan library", "",
		scan ? "scanning " + std::to_string(library::scanDone()) + " / " + std::to_string(library::scanTotal()) : "look for new music" });
	v.subtitle = scan ? "Scanning... " + std::to_string(library::scanDone()) + " / " + std::to_string(library::scanTotal())
		: plural(s.tracks.size(), "track", "tracks");
	return v;
}

View makeGroupList(PageKind kind) {
	View v;
	v.kind = kind;
	v.snap = library::snapshot();
	const library::Snapshot& s = *v.snap;
	const std::vector<library::Group>& src = (kind == PG_ALBUMS) ? s.albums : (kind == PG_ARTISTS) ? s.artists : s.genres;
	v.groups = src;
	v.title = (kind == PG_ALBUMS) ? "Albums" : (kind == PG_ARTISTS) ? "Artists" : "Genres";
	v.subtitle = plural(src.size(), kind == PG_ALBUMS ? "album" : kind == PG_ARTISTS ? "artist" : "genre",
		kind == PG_ALBUMS ? "albums" : kind == PG_ARTISTS ? "artists" : "genres");
	v.empty = src.empty();
	v.emptyMsg = library::scanning() ? "Scanning your music..." : "No tracks in the library yet";
	v.rows.push_back({ R_BACK, "Back", "", "" });
	const RowKind rk = (kind == PG_ALBUMS) ? R_ALBUM : (kind == PG_ARTISTS) ? R_ARTIST : R_GENRE;
	for (size_t i = 0; i < src.size(); i++) {
		const library::Group& g = src[i];
		const std::string sub = (kind == PG_ALBUMS) ? g.sub : plural(g.tracks.size(), "track", "tracks");
		v.rows.push_back({ rk, g.name, "", sub, (int)i });
	}
	v.sel = src.empty() ? 0 : 1;
	return v;
}

void sortByTitle(const library::Snapshot& s, std::vector<int>& idx);

View makeAlbumView(std::shared_ptr<const library::Snapshot> snap, const library::Group& g) {
	const bool various = lowerStr(g.sub).find("various") != std::string::npos;
	return makeTrackView(PG_ALBUM, g.name, (g.sub.empty() ? "" : g.sub + "  -  ") + plural(g.tracks.size(), "track", "tracks"),
		itemsFromTracks(*snap, g.tracks, various ? 2 : 0), "Play album", snap);
}

View makeGenreView(std::shared_ptr<const library::Snapshot> snap, const library::Group& g) {
	std::vector<int> sorted = g.tracks;
	sortByTitle(*snap, sorted);
	return makeTrackView(PG_GENRE, g.name, plural(g.tracks.size(), "track", "tracks"),
		itemsFromTracks(*snap, sorted, 2), "Play all", snap);
}

View makeArtistView(std::shared_ptr<const library::Snapshot> snap, const library::Group& g) {
	View v;
	v.kind = PG_ARTIST;
	v.snap = snap;
	v.title = g.name;
	v.groups = library::groupAlbums(*snap, g.tracks);
	v.subtitle = plural(v.groups.size(), "album", "albums") + "  -  " + plural(g.tracks.size(), "track", "tracks");
	v.rows.push_back({ R_BACK, "Back", "", "" });
	v.rows.push_back({ R_PLAYALL, "Play all by " + g.name, "", "" });
	for (int i : g.tracks) v.trackPaths.push_back(snap->tracks[i].path);
	for (size_t i = 0; i < v.groups.size(); i++) {
		v.rows.push_back({ R_ALBUM, v.groups[i].name, "", plural(v.groups[i].tracks.size(), "track", "tracks"), (int)i });
	}
	v.sel = v.groups.empty() ? 1 : 2;
	return v;
}

// alphabetical by title (case-insensitive) so the letter jump lands on the right songs
void sortByTitle(const library::Snapshot& s, std::vector<int>& idx) {
	std::vector<std::pair<std::string, int>> keyed;
	keyed.reserve(idx.size());
	for (int i : idx) keyed.push_back({ lowerStr(library::displayTitle(s.tracks[i])), i });
	std::stable_sort(keyed.begin(), keyed.end(), [](const std::pair<std::string, int>& a, const std::pair<std::string, int>& b) {
		return a.first < b.first;
	});
	for (size_t k = 0; k < keyed.size(); k++) idx[k] = keyed[k].second;
}

View makeAllSongs() {
	auto snap = library::snapshot();
	std::vector<int> all(snap->tracks.size());
	for (size_t i = 0; i < all.size(); i++) all[i] = (int)i;
	sortByTitle(*snap, all);
	View v = makeTrackView(PG_ALL, "All songs", plural(all.size(), "track", "tracks"), itemsFromTracks(*snap, all, 2), "Play all", snap);
	v.emptyMsg = library::scanning() ? "Scanning your music..." : "No tracks in the library yet";
	return v;
}

View makePlaylistView(const std::string& path, const std::string& name) {
	auto snap = library::snapshot();
	std::unordered_map<std::string, int> index;
	for (size_t i = 0; i < snap->tracks.size(); i++) index[snap->tracks[i].path] = (int)i;
	std::vector<Item> items;
	for (const std::string& p : library::loadPlaylist(path)) {
		Item it;
		it.path = p;
		auto f = index.find(p);
		if (f != index.end()) {
			const library::Track& t = snap->tracks[f->second];
			it.label = library::displayTitle(t);
			it.sub = t.artist.empty() ? t.albumArtist : t.artist;
		}
		else {
			it.label = player::baseName(p);
		}
		items.push_back(std::move(it));
	}
	View v = makeTrackView(PG_PLAYLIST, name, plural(items.size(), "track", "tracks"), items, "Play playlist", snap);
	v.emptyMsg = "This playlist has no playable files";
	v.playlistPath = path;
	v.rows.push_back({ R_RENAMEPLAYLIST, "Rename this playlist", "", "" });
	v.rows.push_back({ R_DELPLAYLIST, "Delete this playlist", "", "" });
	return v;
}

View makePlaylistsView() {
	View v;
	v.kind = PG_PLAYLISTS;
	v.title = "Playlists";
	v.rows.push_back({ R_BACK, "Back", "", "" });
	if (!player::chosenQueuePaths().empty()) v.rows.push_back({ R_SAVEQUEUE, "Save my queued songs as a playlist", "", "" });
	const size_t firstList = v.rows.size();
	const std::vector<library::Playlist> pls = library::listPlaylists(player::musicFolder());
	for (const library::Playlist& p : pls) v.rows.push_back({ R_PLAYLIST, p.name, p.path, "" });
	v.subtitle = plural(pls.size(), "playlist", "playlists");
	v.empty = pls.empty();
	v.emptyMsg = "No playlists yet - add .m3u files to switch/shaderfun/playlists";
	v.sel = (int)(firstList < v.rows.size() ? firstList : v.rows.size() - 1);
	return v;
}

// 'Add to playlist' page: pick a target for the tracks of the highlighted item (kept in trackPaths)
View makePickPlaylistView(const std::vector<std::string>& paths, const std::string& what) {
	View v;
	v.kind = PG_PICKLIST;
	v.title = "Add to playlist";
	v.subtitle = what + "  -  " + plural(paths.size(), "track", "tracks");
	v.trackPaths = paths;
	v.rows.push_back({ R_BACK, "Back", "", "" });
	v.rows.push_back({ R_NEWPLAYLIST, "New playlist", "", "" });
	for (const library::Playlist& p : library::listPlaylists(player::musicFolder()))
		v.rows.push_back({ R_PICKPLAYLIST, p.name, p.path, "" });
	v.sel = 1;
	return v;
}

// keeps the "Playlists" count on the home page in step with the .m3u files on the card
void libUpdatePlaylistCount() {
	if (g_lib.stack.empty()) return;
	g_lib.stack[0].plCount = (int)library::listPlaylists(player::musicFolder()).size();
	g_lib.stack[0].dirty = true;
}

// ---- navigation
void libPush(View v) {
	g_lib.stack.push_back(std::move(v));
	View& t = g_lib.stack.back();
	clampScroll(t);
	ensureVisible(t);
	t.scrollDisp = t.scroll;
}

void libShowMenu() {
	g_lib.mode = M_MENU;
	if (g_lib.stack.empty()) g_lib.stack.push_back(makeHome(library::listPlaylists(player::musicFolder()).size()));
	else { g_lib.stack.resize(1); libUpdatePlaylistCount(); }
}

void libOpenFolders() {
	g_lib.mode = M_FOLDERS;
	if (g_lib.dir.empty()) {
		std::string start = player::musicFolder();
		if (player::listDirectory(start).empty() && player::parentPath(start).empty()) start = "sdmc:/";
		g_lib.dir = start;
	}
	buildRows("");
}

void libJumpMusicFolder() {
	g_lib.mode = M_FOLDERS;
	libEnter(player::musicFolder());
}

void libOpenNow() {
	if (g_lib.open) return;
	g_lib.open = true;
	if (g_lib.mode == M_FOLDERS) buildRows("");
	else if (g_lib.stack.empty()) libShowMenu();
	else libUpdatePlaylistCount();
}

void libClose() { if (g_lib.mode == M_PICK) g_lib.mode = g_lib.pickReturn; g_lib.open = false; g_touchOwned = false; }

// B closes only at the very top; Left goes back but never closes
void libBack(bool allowClose) {
	if (g_lib.mode == M_PICK) { g_lib.mode = g_lib.pickReturn; return; }
	if (g_lib.mode == M_FOLDERS) {
		const std::string par = player::parentPath(g_lib.dir);
		if (!par.empty()) libEnter(par, g_lib.dir);
		else libShowMenu();
	}
	else if (g_lib.stack.size() > 1) { g_lib.stack.pop_back(); if (g_lib.stack.size() == 1) libUpdatePlaylistCount(); }
	else if (allowClose) libClose();
}

// keeps the home page's counts and the scan progress current
void libRefreshHome() {
	if (g_lib.stack.empty()) return;
	View& h = g_lib.stack[0];
	const bool scan = library::scanning();
	if (!h.dirty && h.builtVersion == library::version() && h.builtScanning == scan && (!scan || h.builtDone == library::scanDone())) return;
	View nv = makeHome(h.plCount);
	nv.sel = std::min(std::max(h.sel, 0), (int)nv.rows.size() - 1); // a row may have disappeared (sleep timer option)
	nv.scroll = h.scroll;
	nv.scrollDisp = h.scrollDisp;
	h = std::move(nv);
	clampScroll(g_lib.stack[0]);
}

std::vector<std::string> pathsOf(const library::Snapshot& s, const std::vector<int>& idx) {
	std::vector<std::string> out;
	out.reserve(idx.size());
	for (int i : idx) out.push_back(s.tracks[i].path);
	return out;
}

// ---- naming playlists with the Switch's on-screen keyboard
const char* const BAD_NAME_CHARS = "/\\:*?\"<>|"; // not allowed in file names on the SD card

// Called by the keyboard when the user presses OK: refuses names that cannot be a file name
SwkbdTextCheckResult checkPlaylistName(char* text, size_t size) {
	bool blank = true;
	for (const char* c = text; *c; c++) {
		if (strchr(BAD_NAME_CHARS, *c)) {
			snprintf(text, size, "A name can't contain  / \\ : * ? \" < > |");
			return SwkbdTextCheckResult_Bad;
		}
		if (*c != ' ') blank = false;
	}
	if (blank) {
		snprintf(text, size, "Please type a name.");
		return SwkbdTextCheckResult_Bad;
	}
	return SwkbdTextCheckResult_OK;
}

// Tidies a name for use as a file name (the keyboard check normally makes this a no-op)
std::string cleanPlaylistName(const std::string& in) {
	std::string out;
	for (char c : in) if (!strchr(BAD_NAME_CHARS, c) && (unsigned char)c >= 0x20) out += c;
	while (!out.empty() && (out.back() == ' ' || out.back() == '.')) out.pop_back();
	size_t a = 0;
	while (a < out.size() && out[a] == ' ') a++;
	return out.substr(a);
}

enum NameResult { NAME_OK, NAME_CANCELLED, NAME_UNAVAILABLE };

// Opens the keyboard. NAME_UNAVAILABLE means it could not be shown at all (e.g. the app was launched in a way
// that does not allow applets), so the caller can fall back to an automatic name.
NameResult askPlaylistName(const char* header, const std::string& initial, std::string& out) {
	SwkbdConfig kbd;
	if (R_FAILED(swkbdCreate(&kbd, 0))) return NAME_UNAVAILABLE;
	swkbdConfigMakePresetDefault(&kbd);
	swkbdConfigSetHeaderText(&kbd, header);
	swkbdConfigSetGuideText(&kbd, "Playlist name");
	swkbdConfigSetOkButtonText(&kbd, "Save");
	swkbdConfigSetInitialText(&kbd, initial.c_str());
	swkbdConfigSetStringLenMax(&kbd, 48);
	swkbdConfigSetTextCheckCallback(&kbd, checkPlaylistName);

	char buf[256] = { 0 };
	const u64 t0 = armGetSystemTick();
	const ::Result rc = swkbdShow(&kbd, buf, sizeof(buf));
	const double secs = (double)(armGetSystemTick() - t0) / (double)armGetSystemTickFreq();
	swkbdClose(&kbd);

	if (R_FAILED(rc)) return secs < 0.3 ? NAME_UNAVAILABLE : NAME_CANCELLED; // an instant failure = it never opened
	out = cleanPlaylistName(buf);
	return out.empty() ? NAME_CANCELLED : NAME_OK;
}

// "<dir>/<name>.m3u", with " 2", " 3"... added if that file already exists
std::string uniquePlaylistPath(const std::string& name, std::string& finalName) {
	const std::string dir = library::playlistsDir();
	for (int i = 1; i < 10000; i++) {
		finalName = (i == 1) ? name : name + " " + std::to_string(i);
		const std::string path = dir + "/" + finalName + ".m3u";
		struct stat st;
		if (stat(path.c_str(), &st) != 0) return path;
	}
	finalName = name;
	return dir + "/" + name + ".m3u";
}

// First free "Playlist N" (the keyboard's suggestion, and the fallback name)
std::string suggestPlaylistName() {
	std::string n;
	uniquePlaylistPath("Playlist", n);
	return n == "Playlist" ? "Playlist 1" : n;
}

void saveQueueAsPlaylist() {
	const std::vector<std::string> q = player::chosenQueuePaths(); // not the tracks the player loaded by itself
	if (q.empty()) { showToast("You haven't queued anything yet"); return; }
	mkdir("sdmc:/switch/shaderfun", 0777);
	mkdir(library::playlistsDir().c_str(), 0777);
	char stamp[48];
	time_t now = time(nullptr);
	strftime(stamp, sizeof(stamp), "%Y-%m-%d %H-%M", localtime(&now));
	const std::string stampName = std::string("Queue ") + stamp;
	std::string wanted;
	const NameResult nr = askPlaylistName("Name this playlist", stampName, wanted);
	if (nr == NAME_CANCELLED) { showToast("Cancelled - no playlist was made"); return; }
	if (nr == NAME_UNAVAILABLE) wanted = stampName;
	std::string name;
	const std::string savePath = uniquePlaylistPath(wanted, name);
	if (library::savePlaylist(savePath, q)) {
		showToast("Saved playlist: " + name);
		if (!g_lib.stack.empty()) g_lib.stack.back() = makePlaylistsView(); // show it
		libUpdatePlaylistCount();
	}
	else {
		showToast("Could not save the playlist");
	}
}

void libDeletePlaylist(const std::string& path, const std::string& name) {
	if (!library::deletePlaylist(path)) { showToast("Could not delete the playlist"); return; }
	if (g_lib.stack.size() > 1) g_lib.stack.pop_back(); // leave the deleted playlist's page
	if (g_lib.stack.size() > 1 && g_lib.stack.back().kind == PG_PLAYLISTS) {
		const int oldSel = g_lib.stack.back().sel;
		View nv = makePlaylistsView();
		nv.sel = std::min(std::max(oldSel, 0), (int)nv.rows.size() - 1);
		g_lib.stack.back() = std::move(nv);
		ensureVisible(g_lib.stack.back());
		g_lib.stack.back().scrollDisp = g_lib.stack.back().scroll;
	}
	libUpdatePlaylistCount();
	showToast("Deleted playlist: " + name);
}

// target empty = make a new playlist ("Playlist 1", "Playlist 2"...). paths is a copy on purpose: the picker page goes away here.
void libCompleteAdd(const std::string& targetPath, const std::string& targetName, std::vector<std::string> paths) {
	std::string path = targetPath, name = targetName;
	int added;
	if (path.empty()) {
		mkdir("sdmc:/switch/shaderfun", 0777);
		mkdir(library::playlistsDir().c_str(), 0777);
		std::string wanted;
		const NameResult nr = askPlaylistName("Name your new playlist", suggestPlaylistName(), wanted);
		if (nr == NAME_CANCELLED) { showToast("Cancelled - no playlist was made"); return; }
		if (nr == NAME_UNAVAILABLE) wanted = suggestPlaylistName(); // keyboard could not open: automatic name
		path = uniquePlaylistPath(wanted, name);
		added = library::savePlaylist(path, paths) ? (int)paths.size() : -1;
	}
	else {
		added = library::appendToPlaylist(path, paths);
	}
	if (added < 0) { showToast("Could not write the playlist"); return; }

	g_lib.mode = g_lib.pickReturn; // back to the page we came from
	if (g_lib.mode == M_MENU && !g_lib.stack.empty()) {
		View& u = g_lib.stack.back(); // refresh it if it shows the playlist (or the list of playlists) we just changed
		const int sel = u.sel;
		const float sc = u.scroll;
		bool rebuilt = false;
		if (u.kind == PG_PLAYLIST && u.playlistPath == path) { const std::string t = u.title; u = makePlaylistView(path, t); rebuilt = true; }
		else if (u.kind == PG_PLAYLISTS) { u = makePlaylistsView(); rebuilt = true; }
		if (rebuilt) {
			u.sel = std::min(std::max(sel, 0), (int)u.rows.size() - 1);
			u.scroll = sc;
			ensureVisible(u);
			u.scrollDisp = u.scroll;
		}
	}
	libUpdatePlaylistCount();
	showToast(added == 0 ? "Already in " + name
		: "Added " + (added == 1 ? std::string("1 track") : std::to_string(added) + " tracks") + " to " + name);
}

void libRenamePlaylist() {
	View& v = cur();
	std::string wanted;
	const NameResult nr = askPlaylistName("Rename playlist", v.title, wanted);
	if (nr == NAME_UNAVAILABLE) { showToast("The keyboard could not be opened"); return; }
	if (nr == NAME_CANCELLED || wanted == v.title) return;
	struct stat st;
	// keep the file where it is: same folder, new name
	const std::string dir = player::parentPath(v.playlistPath);
	const std::string target = dir + "/" + wanted + ".m3u";
	if (stat(target.c_str(), &st) == 0) { showToast("A playlist called \"" + wanted + "\" already exists"); return; }
	if (!library::renamePlaylist(v.playlistPath, target)) { showToast("Could not rename the playlist"); return; }
	v.title = wanted;
	v.playlistPath = target;
	if (g_lib.stack.size() >= 2) { // update the list of playlists underneath
		View& u = g_lib.stack[g_lib.stack.size() - 2];
		if (u.kind == PG_PLAYLISTS) {
			const int sel = u.sel;
			const float sc = u.scroll;
			u = makePlaylistsView();
			u.sel = std::min(std::max(sel, 0), (int)u.rows.size() - 1);
			u.scroll = sc;
			ensureVisible(u);
			u.scrollDisp = u.scroll;
		}
	}
	showToast("Renamed to: " + wanted);
}

void libActivate(int idx) {
	View& v = cur();
	if (idx < 0 || idx >= (int)v.rows.size()) return;
	const Row row = v.rows[idx]; // copies: the views are rebuilt / pushed below
	switch (row.kind) {
	// ---- folder browser
	case R_UP: libEnter(row.path, g_lib.dir); break;
	case R_DIR: libEnter(row.path); break;
	case R_PLAYDIR:
		if (player::playFolder(g_lib.dir)) { showToast("Playing folder: " + player::baseName(g_lib.dir)); libClose(); }
		else showToast("No music files in this folder");
		break;
	case R_SETDIR:
		if (g_lib.dir == player::musicFolder()) { showToast("Already your music folder"); break; }
		player::setMusicFolder(g_lib.dir);
		library::startScan(g_lib.dir); // index the new folder in the background
		showToast("Music folder set: " + g_lib.dir);
		buildRows("");
		break;
	case R_FILE:
		if (player::playFile(row.path)) libClose();
		else showToast("Could not play that file");
		break;

	// ---- menu
	case R_BACK: libBack(false); break;
	case R_HOME_FOLDERS: libOpenFolders(); break;
	case R_HOME_ALBUMS: libPush(makeGroupList(PG_ALBUMS)); break;
	case R_HOME_ARTISTS: libPush(makeGroupList(PG_ARTISTS)); break;
	case R_HOME_GENRES: libPush(makeGroupList(PG_GENRES)); break;
	case R_HOME_PLAYLISTS: libUpdatePlaylistCount(); libPush(makePlaylistsView()); break;
	case R_HOME_ALL: libPush(makeAllSongs()); break;
	case R_HOME_AUTO: cycleAuto(); if (!g_lib.stack.empty()) g_lib.stack[0].dirty = true; break;
	case R_HOME_SLEEPACT:
		player::setConfigInt("sleep_quit", player::configInt("sleep_quit", 1) ? 0 : 1);
		showToast(player::configInt("sleep_quit", 1) ? "Sleep timer: pauses the music, then closes the app" : "Sleep timer: only pauses the music");
		if (!g_lib.stack.empty()) g_lib.stack[0].dirty = true;
		break;
	case R_HOME_SLEEP: cycleSleep(); if (!g_lib.stack.empty()) g_lib.stack[0].dirty = true; break;
	case R_HOME_RESUME:
		player::setConfigInt("resume_play", player::configInt("resume_play", 0) ? 0 : 1);
		showToast(player::configInt("resume_play", 0) ? "On launch: music continues playing" : "On launch: music is ready but paused");
		if (!g_lib.stack.empty()) g_lib.stack[0].dirty = true;
		break;
	case R_HOME_RESCAN:
		library::startScan(player::musicFolder());
		showToast("Scanning the music folder...");
		break;
	case R_ALBUM: { const library::Group g = v.groups[row.ref]; auto snap = v.snap; libPush(makeAlbumView(snap, g)); break; }
	case R_ARTIST: { const library::Group g = v.groups[row.ref]; auto snap = v.snap; libPush(makeArtistView(snap, g)); break; }
	case R_GENRE: { const library::Group g = v.groups[row.ref]; auto snap = v.snap; libPush(makeGenreView(snap, g)); break; }
	case R_PLAYLIST: libPush(makePlaylistView(row.path, row.label)); break;
	case R_SAVEQUEUE: saveQueueAsPlaylist(); break;
	case R_NEWPLAYLIST: libCompleteAdd("", "", v.trackPaths); break;
	case R_PICKPLAYLIST: libCompleteAdd(row.path, row.label, v.trackPaths); break;
	case R_RENAMEPLAYLIST: libRenamePlaylist(); break;
	case R_DELPLAYLIST:
		if (!v.confirmDelete) { // first press only asks; the second one deletes
			v.confirmDelete = true;
			v.rows[idx].label = "Press A again to delete it for good";
			showToast("Move away to cancel, or press A again to delete");
		}
		else libDeletePlaylist(v.playlistPath, v.title); // v is gone after this
		break;
	case R_PLAYALL:
		if (player::playTracks(v.trackPaths, 0)) { showToast("Playing: " + v.title); libClose(); }
		else showToast("Nothing to play here");
		break;
	case R_TRACK:
		if (player::playTracks(v.trackPaths, row.ref)) libClose();
		else showToast("Could not play that track");
		break;
	}
}

// ---- add to queue (L3): whatever is highlighted goes to the end of the current queue
bool rowTracks(const View& v, const Row& row, std::vector<std::string>& out, std::string& name) {
	name = row.label;
	switch (row.kind) {
	case R_DIR: out = player::tracksInFolder(row.path); break;
	case R_PLAYDIR: out = player::tracksInFolder(g_lib.dir); name = player::baseName(g_lib.dir); break;
	case R_FILE: out.push_back(row.path); break;
	case R_TRACK: if (row.ref >= 0 && row.ref < (int)v.trackPaths.size()) out.push_back(v.trackPaths[row.ref]); break;
	case R_PLAYALL: out = v.trackPaths; name = v.title; break;
	case R_ALBUM: case R_ARTIST: case R_GENRE: out = pathsOf(*v.snap, v.groups[row.ref].tracks); break;
	case R_PLAYLIST: out = library::loadPlaylist(row.path); break;
	default: return false;
	}
	return true;
}

void libQueueSelected(bool playNext) {
	View& v = cur();
	if (v.sel < 0 || v.sel >= (int)v.rows.size()) return;
	std::vector<std::string> paths;
	std::string name;
	if (!rowTracks(v, v.rows[v.sel], paths, name)) {
		showToast("Highlight a song, album, artist, genre, playlist or folder to queue it");
		return;
	}
	if (paths.empty()) { showToast("Nothing to queue there"); return; }
	const bool wasEmpty = !player::hasTracks();
	const int added = player::enqueue(paths, playNext);
	if (added <= 0) { showToast("Could not queue that"); return; }
	if (wasEmpty) { showToast("Playing: " + name); return; }
	showToast(std::string(playNext ? "Playing next: " : "Added to queue: ") + name +
		(added > 1 ? " (" + std::to_string(added) + " tracks)" : ""));
}

// ---- add to playlist (R3): the highlighted song / album / artist / genre / folder goes into a playlist of your choice
void libAddToPlaylistPicker() {
	if (g_lib.mode == M_PICK) return;
	View& v = cur();
	if (v.sel < 0 || v.sel >= (int)v.rows.size()) return;
	std::vector<std::string> paths;
	std::string name;
	if (!rowTracks(v, v.rows[v.sel], paths, name)) {
		showToast("Highlight a song, album, artist, genre or folder to add it to a playlist");
		return;
	}
	if (paths.empty()) { showToast("Nothing to add there"); return; }
	g_lib.pickReturn = g_lib.mode;
	g_lib.pick = makePickPlaylistView(paths, name);
	g_lib.mode = M_PICK;
	clampScroll(g_lib.pick);
	ensureVisible(g_lib.pick);
	g_lib.pick.scrollDisp = g_lib.pick.scroll;
}

// ---- jump by letter (right stick left/right): previous / next first letter in the list
char rowLetter(const Row& r) {
	switch (r.kind) {
	case R_DIR: case R_FILE: case R_TRACK: case R_ALBUM: case R_ARTIST: case R_GENRE: case R_PLAYLIST: case R_PICKPLAYLIST: break;
	default: return 0; // Back / Play all / home rows etc. do not belong to a letter
	}
	if (r.label.empty()) return '#';
	const unsigned char c = (unsigned char)r.label[0];
	if (c < 0x80 && isalpha(c)) return (char)toupper(c);
	return '#';
}

void libJumpLetter(int dir) {
	View& v = cur();
	const int n = (int)v.rows.size();
	if (n == 0) return;
	auto L = [&](int i) { return rowLetter(v.rows[i]); };
	const int sel = std::min(std::max(v.sel, 0), n - 1);
	const char c = L(sel);
	int target = -1;
	if (dir > 0) {
		for (int i = sel + 1; i < n; i++) { const char l = L(i); if (l && l != c) { target = i; break; } }
	}
	else if (c) {
		int start = sel;
		while (start > 0 && L(start - 1) == c) start--;
		if (start < sel) target = start;            // first press: top of this letter
		else {                                      // already there: top of the previous letter
			int i = start - 1;
			while (i >= 0 && !L(i)) i--;
			if (i >= 0) {
				const char pc = L(i);
				while (i > 0 && L(i - 1) == pc) i--;
				target = i;
			}
		}
	}
	if (target < 0) return;
	v.sel = target;
	ensureVisible(v);
	const char l = L(target);
	showToast(l == '#' ? std::string("Jump to 0-9 / symbols") : std::string("Jump to ") + l);
}

// X: play whatever is highlighted (a folder, album, artist, genre or playlist) from its first track
void libPlaySelected() {
	View& v = cur();
	if (v.sel < 0 || v.sel >= (int)v.rows.size()) return;
	const Row row = v.rows[v.sel];
	std::vector<std::string> paths;
	std::string name = row.label;
	switch (row.kind) {
	case R_DIR: case R_UP: case R_PLAYDIR: case R_SETDIR: case R_FILE: {
		const std::string target = (row.kind == R_DIR) ? row.path : g_lib.dir;
		if (row.kind == R_FILE) { libActivate(v.sel); return; }
		if (player::playFolder(target)) { showToast("Playing folder: " + player::baseName(target)); libClose(); }
		else showToast("No music files in that folder");
		return;
	}
	case R_ALBUM: case R_ARTIST: case R_GENRE:
		paths = pathsOf(*v.snap, v.groups[row.ref].tracks);
		break;
	case R_PLAYLIST:
		paths = library::loadPlaylist(row.path);
		break;
	case R_TRACK: case R_PLAYALL:
		libActivate(v.sel);
		return;
	default:
		showToast("Highlight an album, artist, genre or playlist to play it");
		return;
	}
	if (player::playTracks(paths, 0)) { showToast("Playing: " + name); libClose(); }
	else showToast("Nothing to play there");
}

void libMove(int d) {
	View& v = cur();
	const int n = (int)v.rows.size();
	if (n == 0) return;
	v.sel = std::min(std::max(v.sel + d, 0), n - 1);
	ensureVisible(v);
}

// Left stick: jump a page of rows, or straight to the start / end of the list
const int LIB_PAGE_ROWS = 10;

void libJumpTo(int index) {
	View& v = cur();
	const int n = (int)v.rows.size();
	if (n == 0) return;
	v.sel = std::min(std::max(index, 0), n - 1);
	ensureVisible(v);
}

bool rowOpensSomething(RowKind k) {
	return k == R_DIR || k == R_ALBUM || k == R_ARTIST || k == R_GENRE || k == R_PLAYLIST ||
		(k >= R_HOME_FOLDERS && k <= R_HOME_ALL);
}

// ============================================================================ track info panel
const float INFO_W = 760.0f;

struct Info {
	bool open = false;
	float slide = 0.0f;
	std::string forPath;       // file the data below belongs to
	tags::TrackTags t;
	int coverW = 0, coverH = 0;
} g_info;

void infoFreeCover() {
	if (g_coverTex) glDeleteTextures(1, &g_coverTex);
	g_coverTex = 0;
	g_info.coverW = g_info.coverH = 0;
}

// Area-average downscale (RGBA8) so big album art stays small in video memory
void boxDownscale(const uint8_t* src, int sw, int sh, int srcPitch, std::vector<uint8_t>& dst, int dw, int dh) {
	dst.assign((size_t)dw * dh * 4, 0);
	for (int y = 0; y < dh; y++) {
		const int y0 = (int)((int64_t)y * sh / dh);
		const int y1 = std::max(y0 + 1, (int)((int64_t)(y + 1) * sh / dh));
		for (int x = 0; x < dw; x++) {
			const int x0 = (int)((int64_t)x * sw / dw);
			const int x1 = std::max(x0 + 1, (int)((int64_t)(x + 1) * sw / dw));
			uint32_t acc[4] = { 0, 0, 0, 0 };
			for (int yy = y0; yy < y1; yy++) {
				const uint8_t* row = src + (size_t)yy * srcPitch;
				for (int xx = x0; xx < x1; xx++) for (int c = 0; c < 4; c++) acc[c] += row[xx * 4 + c];
			}
			const uint32_t cnt = (uint32_t)((y1 - y0) * (x1 - x0));
			for (int c = 0; c < 4; c++) dst[((size_t)y * dw + x) * 4 + c] = (uint8_t)(acc[c] / cnt);
		}
	}
}

void infoUploadCover(const std::vector<uint8_t>& encoded) {
	infoFreeCover();
	if (encoded.empty()) return;
	SDL_Surface* raw = IMG_Load_RW(SDL_RWFromConstMem(encoded.data(), (int)encoded.size()), 1);
	if (!raw) return;
	SDL_Surface* s = SDL_ConvertSurfaceFormat(raw, SDL_PIXELFORMAT_ABGR8888, 0); // bytes R,G,B,A
	SDL_FreeSurface(raw);
	if (!s) return;

	const int MAXSIDE = 512;
	int w = s->w, h = s->h;
	std::vector<uint8_t> scaled;
	const uint8_t* pixels = (const uint8_t*)s->pixels;
	int pitch = s->pitch;
	if (w > MAXSIDE || h > MAXSIDE) {
		const float k = (float)MAXSIDE / (float)std::max(w, h);
		const int nw = std::max(1, (int)(w * k)), nh = std::max(1, (int)(h * k));
		boxDownscale(pixels, w, h, pitch, scaled, nw, nh);
		pixels = scaled.data();
		pitch = nw * 4;
		w = nw;
		h = nh;
	}
	GLint maxTex = 2048;
	glGetIntegerv(GL_MAX_TEXTURE_SIZE, &maxTex);
	if (w <= maxTex && h <= maxTex) {
		std::vector<uint8_t> packed;
		if (pitch != w * 4) { // tightly pack the rows for GL
			packed.resize((size_t)w * h * 4);
			for (int y = 0; y < h; y++) memcpy(&packed[(size_t)y * w * 4], pixels + (size_t)y * pitch, (size_t)w * 4);
			pixels = packed.data();
		}
		glGenTextures(1, &g_coverTex);
		glActiveTexture(GL_TEXTURE0);
		glBindTexture(GL_TEXTURE_2D, g_coverTex);
		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
		glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
		g_info.coverW = w;
		g_info.coverH = h;
	}
	SDL_FreeSurface(s);
}

void infoLoad() {
	g_info.forPath = player::currentPath();
	g_info.t = tags::TrackTags();
	infoFreeCover();
	if (g_info.forPath.empty()) return;
	tags::read(g_info.forPath, g_info.t, player::duration());
	infoUploadCover(g_info.t.cover);
	g_info.t.cover.clear();
	g_info.t.cover.shrink_to_fit();
}

void closeInfo() { g_info.open = false; }

// ---- lyrics: timed lyrics slide past over the visuals, plain lyrics open as a page you can scroll
struct LyricsState {
	std::string forPath;        // the song the loaded lyrics belong to
	lyrics::Lyrics data;
	bool wanted = false;        // switched on with the right stick
	float alpha = 0.0f;         // fade in / out
	float linePos = 0.0f;       // smoothed (fractional) index of the line being sung, for the sliding animation
	float scroll = 0.0f;        // page: scroll offset in pixels
} g_lyr;

const float LYR_AREA_TOP = 140.0f;
const Color LYR_CURRENT = { 1.00f, 0.92f, 0.35f, 1.0f }; // the line being sung (yellow)
const Color LYR_NEXT = { 0.62f, 1.00f, 0.50f, 1.0f };    // the line coming up next (light green)

bool lyricsTimedVisible() { return g_lyr.wanted && g_lyr.data.found && g_lyr.data.timed && !g_lib.open && !g_info.open && player::hasTracks(); }
bool lyricsPageVisible() { return g_lyr.wanted && g_lyr.data.found && !g_lyr.data.timed && !g_lib.open && !g_info.open && player::hasTracks(); }
float lyricsLineH() { return g_fontH[SZ_NORMAL] + 5.0f; }
float lyricsMaxScroll() {
	const float areaH = (float)g_h - 70.0f - LYR_AREA_TOP;
	return fmaxf(0.0f, (float)g_lyr.data.plain.size() * lyricsLineH() - areaH);
}

// (re)loads the lyrics when another song starts
void lyricsRefresh() {
	const std::string path = player::hasTracks() ? player::currentPath() : std::string();
	if (path == g_lyr.forPath) return;
	g_lyr.forPath = path;
	g_lyr.data = lyrics::Lyrics();
	g_lyr.linePos = 0.0f;
	g_lyr.scroll = 0.0f;
	if (!path.empty()) lyrics::load(path, g_lyr.data);
	if (g_lyr.data.found && !g_lyr.data.timed) g_lyr.wanted = false; // a page does not open by itself on the next song
}

void drawLyrics() {
	if (g_lyr.alpha < 0.01f) return;
	g_alpha = g_lyr.alpha;
	const lyrics::Lyrics& L = g_lyr.data;
	const Color shadow = { 0.0f, 0.0f, 0.0f, 0.85f };

	if (L.timed) {
		const float cx = g_w * 0.5f, baseY = 318.0f, step = 56.0f, maxW = g_w - 200.0f;
		// soft backing so any shader stays readable: tall enough for two lines above and two below the current one
		rrect(110, baseY - 160, g_w - 220.0f, 320, 26, { 0.0f, 0.0f, 0.0f, 0.58f }); //lyrics box
		const int curIdx = (int)floorf(g_lyr.linePos + 0.5f); // the line nearest the middle of the box
		const int first = (int)floorf(g_lyr.linePos) - 2;
		for (int i = first; i <= first + 6; i++) {
			if (i < 0 || i >= (int)L.lines.size() || L.lines[i].text.empty()) continue;
			const float rel = (float)i - g_lyr.linePos;
			const float dist = fabsf(rel);
			const float a = fminf(1.0f, fmaxf(0.0f, 1.0f - dist * 0.36f));
			const int sz = dist < 0.5f ? SZ_TITLE : SZ_NORMAL;
			const float y = baseY + rel * step - g_fontH[sz] * 0.5f;
			const bool isNext = (i == curIdx + 1);
			const Color col = dist < 0.5f ? withA(LYR_CURRENT, a)
				: isNext ? withA(LYR_NEXT, fmaxf(a, 0.85f)) // the upcoming line stays clearly readable
				: withA(C_DIM, a);
			drawText(sz, cx + 2, y + 2, L.lines[i].text, withA(shadow, a), maxW, CENTER);
			drawText(sz, cx, y, L.lines[i].text, col, maxW, CENTER);
		}
		return;
	}

	// plain lyrics: a page
	rrect(0, 0, (float)g_w, (float)g_h, 0, { 0.01f, 0.02f, 0.04f, 0.88f });
	drawText(SZ_TITLE, 60, 14, "Lyrics", C_WHITE);
	drawText(SZ_SMALL, 62, 66, player::title(), C_DIM, g_w - 400.0f);
	drawText(SZ_SMALL, g_w - 60.0f, 66, "Up / Down: scroll     B: close", C_DIM, 0, RIGHT);
	rrect(60, 100, g_w - 120.0f, 1, 0, withA(C_WHITE, 0.12f));

	const float areaBottom = (float)g_h - 56.0f, lineH = lyricsLineH();
	g_lyr.scroll = fminf(fmaxf(g_lyr.scroll, 0.0f), lyricsMaxScroll());
	for (size_t i = 0; i < L.plain.size(); i++) {
		const float y = LYR_AREA_TOP + i * lineH - g_lyr.scroll;
		if (y < LYR_AREA_TOP - 2.0f || y + lineH > areaBottom + 2.0f) continue;
		drawText(SZ_NORMAL, 80, y, L.plain[i], C_WHITE, g_w - 160.0f);
	}
}


void toggleInfo() {
	if (g_info.open) { closeInfo(); return; }
	if (g_lib.open) return;
	if (!player::hasTracks()) { showToast("No track to show"); return; }
	g_info.open = true;
	infoLoad();
}

} // namespace

// ============================================================================ public API
namespace {

bool g_touching = false; // current touch state (for pressed-button highlight)

float seekFracAt(float x) { return fminf(1.0f, fmaxf(0.0f, (x - BAR_X0) / (BAR_X1 - BAR_X0))); }
float volFracAt(float x) { return fminf(1.0f, fmaxf(0.0f, (x - VOL_X0) / (VOL_X1 - VOL_X0))); }

const HitBox& boxFor(Target t) {
	for (const HitBox& b : HUD_BOXES) if (b.id == t) return b;
	return HUD_BOXES[0];
}

bool pressed(Target t) {
	return g_touching && g_touchOwned && !g_lib.open && g_touchTarget == t && inBox(boxFor(t), g_touchLX, g_touchLY);
}

void doAction(Target t) {
	switch (t) {
	case T_PREV: player::prev(); break;
	case T_REW: player::seekBy(-10); break;
	case T_PLAY:
		if (!player::hasTracks()) { showToast("No music found - choose a folder"); libOpenNow(); }
		else player::togglePause();
		break;
	case T_FFW: player::seekBy(10); break;
	case T_NEXT: player::next(); break;
	case T_AUTO: cycleAuto(); break;
	case T_LIB: closeInfo(); libOpenNow(); break;
	case T_INFO: toggleInfo(); break;
	case T_MODE: player::cycleMode(); showToast(player::modeName(player::mode())); break;
	default: break;
	}
}

} // namespace

void addFontFile(const char* path) {
	FontSource s;
	s.path = path;
	g_sources.push_back(s);
}

void addFontMemory(const void* data, size_t size) {
	FontSource s;
	s.data = data;
	s.size = size;
	g_sources.push_back(s);
}

bool ready() { return g_ready; }
bool libraryOpen() { return g_lib.open; }
bool infoOpen() { return g_info.open; }
bool lyricsAvailable() { return g_lyr.data.found; }
void lyricsShow(bool show) {
	if (!g_ready) return;
	if (show) {
		if (!g_lyr.data.found) { showToast("No lyrics found for this song"); return; }
		g_lyr.wanted = true;
		showToast(g_lyr.data.timed ? "Lyrics on" : "Lyrics - Up / Down to scroll, B to close");
	}
	else if (g_lyr.wanted) {
		g_lyr.wanted = false;
		showToast("Lyrics off");
	}
}
int autoCycleSeconds() { return g_autoSecs; }
void toast(const std::string& text) { if (g_ready) showToast(text); }

bool init(int w, int h) {
	if (g_ready) return true;
	g_w = w;
	g_h = h;

	for (const FontSource& src : g_sources) {
		TTF_Font* faces[SZ_COUNT] = {};
		bool ok = true;
		for (int sz = 0; sz < SZ_COUNT && ok; sz++) {
			if (!src.path.empty()) faces[sz] = TTF_OpenFont(src.path.c_str(), FONT_PT[sz]);
			else faces[sz] = TTF_OpenFontRW(SDL_RWFromConstMem(src.data, (int)src.size), 1, FONT_PT[sz]);
			if (!faces[sz]) ok = false;
		}
		if (!ok) {
			for (int sz = 0; sz < SZ_COUNT; sz++) if (faces[sz]) TTF_CloseFont(faces[sz]);
			printf("UI: skipping font %s\n", src.path.empty() ? "(memory)" : src.path.c_str());
			continue;
		}
		for (int sz = 0; sz < SZ_COUNT; sz++) g_faces[sz].push_back(faces[sz]);
	}
	if (g_faces[0].empty()) {
		printf("UI disabled: no usable font\n");
		return false;
	}
	for (int sz = 0; sz < SZ_COUNT; sz++) g_fontH[sz] = TTF_FontHeight(g_faces[sz][0]);

	// atlas texture (alpha only), cleared to 0
	glGenTextures(1, &g_atlasTex);
	glBindTexture(GL_TEXTURE_2D, g_atlasTex);
	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
	glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
	{
		std::vector<uint8_t> zero((size_t)ATLAS * ATLAS, 0);
		glTexImage2D(GL_TEXTURE_2D, 0, GL_ALPHA, ATLAS, ATLAS, 0, GL_ALPHA, GL_UNSIGNED_BYTE, zero.data());
	}

	GLuint vs = compile(GL_VERTEX_SHADER, VS);
	GLuint fs = vs ? compile(GL_FRAGMENT_SHADER, FS) : 0;
	if (!vs || !fs) {
		if (vs) glDeleteShader(vs);
		if (fs) glDeleteShader(fs);
		return false;
	}
	g_prog = glCreateProgram();
	glAttachShader(g_prog, vs);
	glAttachShader(g_prog, fs);
	glBindAttribLocation(g_prog, 0, "aPos");
	glBindAttribLocation(g_prog, 1, "aUV");
	glBindAttribLocation(g_prog, 2, "aCol");
	glBindAttribLocation(g_prog, 3, "aShape");
	glBindAttribLocation(g_prog, 4, "aParam");
	glLinkProgram(g_prog);
	glDeleteShader(vs);
	glDeleteShader(fs);
	GLint linked = 0;
	glGetProgramiv(g_prog, GL_LINK_STATUS, &linked);
	if (!linked) {
		printf("UI: program link failed\n");
		glDeleteProgram(g_prog);
		g_prog = 0;
		return false;
	}
	g_uAtlas = glGetUniformLocation(g_prog, "uAtlas");
	g_uCover = glGetUniformLocation(g_prog, "uCover");
	glGenBuffers(1, &g_vbo);

	for (int i = 0; i < IC_COUNT; i++) { rasterIcon((Icon)i); placeIcon((Icon)i); }
	for (int sz = 0; sz < SZ_COUNT; sz++) {
		for (uint32_t c = 32; c < 127; c++) glyph(sz, c); // warm up the ASCII range
	}

	g_lastTrackChange = player::trackChangeCounter();
	g_hudTimer = HUD_SECONDS;
	{ // restore the saved auto-change interval (only the known presets are accepted)
		const int saved = player::configInt("auto_cycle", 0);
		g_autoSecs = 0;
		for (int v : AUTO_STEPS) if (v == saved) g_autoSecs = saved;
	}
	g_ready = true;
	printf("UI ready (%zu font(s))\n", g_faces[0].size());
	return true;
}

void shutdown() {
	infoFreeCover();
	if (g_vbo) glDeleteBuffers(1, &g_vbo);
	if (g_prog) glDeleteProgram(g_prog);
	if (g_atlasTex) glDeleteTextures(1, &g_atlasTex);
	g_vbo = g_prog = g_atlasTex = 0;
	for (int sz = 0; sz < SZ_COUNT; sz++) {
		for (TTF_Font* f : g_faces[sz]) TTF_CloseFont(f);
		g_faces[sz].clear();
	}
	g_glyphs.clear();
	g_shelves.clear();
	g_nextY = 0;
	g_ready = false;
}

Result update(const Input& in) {
	Result res;
	if (!g_ready) return res;
	const float dt = fminf(fmaxf(in.dt, 0.0f), 0.1f);
	const bool touchDown = in.touching && !g_prevTouching;
	const bool touchUp = !in.touching && g_prevTouching;
	g_touching = in.touching;

	// ---- activity / timers
	if (in.down != 0 || in.touching) g_hudTimer = HUD_SECONDS;
	else g_hudTimer = fmaxf(0.0f, g_hudTimer - dt);
	if (player::trackChangeCounter() != g_lastTrackChange) {
		g_lastTrackChange = player::trackChangeCounter();
		g_hudTimer = HUD_SECONDS;
	}
	g_toastTimer = fmaxf(0.0f, g_toastTimer - dt);

	// ---- sleep timer
	{
		if (g_quitCountdown > 0.0f) { // about to close: any button, touch or playing music cancels it
			if (in.down || in.touching || player::isPlaying()) { g_quitCountdown = 0.0f; showToast("Staying open"); }
			else {
				g_quitCountdown -= dt;
				if (g_quitCountdown <= 0.0f) { g_quitCountdown = 0.0f; res.requestQuit = true; }
			}
		}
		if (player::consumeSleepFired()) {
			g_sleepStep = 0;
			if (player::configInt("sleep_quit", 1)) {
				showToast("Sleep timer: music paused. Closing in 5 s - press any button to stay");
				g_toastTimer = 5.0f;
				g_quitCountdown = 5.0f;
			}
			else showToast("Sleep timer: music paused. Good night!");
			appletSetMediaPlaybackState(false); // the Switch may now go to sleep on its own (main.cpp had blocked that)
			g_mediaStateReleased = true;
		}
		if (g_mediaStateReleased && player::isPlaying()) { // music is back: keep the console awake again
			appletSetMediaPlaybackState(true);
			g_mediaStateReleased = false;
		}
		if (g_lib.open && !g_lib.stack.empty()) { // keep the "minutes left" text on the home page up to date
			static std::string lastLabel;
			const std::string now = sleepLabel();
			if (now != lastLabel) { lastLabel = now; g_lib.stack[0].dirty = true; }
		}
	}

	// ---- touch: begin
	static float startScroll = 0.0f;
	if (touchDown) {
		g_touchSX = g_touchLX = in.touchX;
		g_touchSY = g_touchLY = in.touchY;
		g_touchMoved = false;
		g_touchTarget = T_NONE;
		g_touchOwned = false;
		startScroll = g_lib.open ? cur().scroll : 0.0f;
		if (g_lib.open) {
			g_touchOwned = true;
			const float x = in.touchX, y = in.touchY;
			auto near = [&](float cx, float cy) { return fabsf(x - cx) < 32 && fabsf(y - cy) < 32; };
			if (x > LIB_W) g_touchTarget = T_OUTSIDE;
			else if (near(LIB_W - 44, 50)) g_touchTarget = T_CLOSE;
			else if (near(LIB_W - 108, 50)) g_touchTarget = T_HOME;
			else if (near(LIB_W - 172, 50)) g_touchTarget = T_MENU;
			else if (y >= listTop() && y < listBottom()) g_touchTarget = T_LIST;
		}
		else if (g_info.open) {
			g_touchOwned = true;
			if (in.touchX < g_w - INFO_W) g_touchTarget = T_OUTSIDE;
			else if (fabsf(in.touchX - (g_w - 44.0f)) < 32 && fabsf(in.touchY - 50.0f) < 32) g_touchTarget = T_CLOSE;
		}
		else if (g_hudAlpha > 0.5f && in.touchY >= HUD_TOP) {
			g_touchOwned = true;
			g_touchTarget = hudTargetAt(in.touchX, in.touchY);
			if (g_touchTarget == T_SEEK) g_seekFrac = seekFracAt(in.touchX);
			if (g_touchTarget == T_VOL) player::setVolume((int)(volFracAt(in.touchX) * 128.0f + 0.5f));
		}
	}

	// ---- touch: hold / move
	if (in.touching && !touchDown && g_touchOwned) {
		g_touchLX = in.touchX;
		g_touchLY = in.touchY;
		if (fabsf(in.touchX - g_touchSX) > 14 || fabsf(in.touchY - g_touchSY) > 14) g_touchMoved = true;
		if (g_lib.open) {
			if (g_touchTarget == T_LIST && g_touchMoved) {
				View& cv = cur();
				cv.scroll = startScroll + (g_touchSY - in.touchY);
				clampScroll(cv);
				cv.scrollDisp = cv.scroll;
			}
		}
		else {
			if (g_touchTarget == T_SEEK) g_seekFrac = seekFracAt(in.touchX);
			if (g_touchTarget == T_VOL) player::setVolume((int)(volFracAt(in.touchX) * 128.0f + 0.5f));
		}
	}

	// ---- touch: release
	if (touchUp && g_touchOwned) {
		if (g_lib.open) {
			if (!g_touchMoved) {
				if (g_touchTarget == T_LIST) {
					const int idx = (int)((g_touchSY - listTop() + cur().scrollDisp) / ROW_H);
					if (idx >= 0 && idx < (int)cur().rows.size()) { cur().sel = idx; libActivate(idx); }
				}
				else if (g_touchTarget == T_CLOSE || g_touchTarget == T_OUTSIDE) libClose();
				else if (g_touchTarget == T_HOME) libJumpMusicFolder();
				else if (g_touchTarget == T_MENU) libShowMenu();
			}
		}
		else if (g_info.open) {
			if (!g_touchMoved && (g_touchTarget == T_CLOSE || g_touchTarget == T_OUTSIDE)) closeInfo();
		}
		else if (g_touchTarget == T_SEEK) {
			if (player::canSeek() && player::duration() > 0) player::seekTo(g_seekFrac * player::duration());
		}
		else if (g_touchTarget != T_NONE && g_touchTarget != T_VOL) {
			if (hudTargetAt(g_touchLX, g_touchLY) == g_touchTarget) doAction(g_touchTarget);
		}
		g_touchOwned = false;
	}
	res.consumedTouch = g_touchOwned && in.touching;

	// ---- gamepad
	const uint32_t d = in.down, h = in.held;
	if (g_lib.open) {
		res.consumedButtons = ~0u;
		if (g_repUp.fire(d & BTN_UP, h & BTN_UP, dt)) libMove(-1);
		if (g_repDown.fire(d & BTN_DOWN, h & BTN_DOWN, dt)) libMove(+1);
		if (g_repPgDown.fire(d & BTN_LS_RIGHT, h & BTN_LS_RIGHT, dt, 0.4f, 0.14f)) libMove(+LIB_PAGE_ROWS);
		if (g_repPgUp.fire(d & BTN_LS_LEFT, h & BTN_LS_LEFT, dt, 0.4f, 0.14f)) libMove(-LIB_PAGE_ROWS);
		if (d & BTN_LS_UP) libJumpTo(0);
		if (d & BTN_LS_DOWN) libJumpTo((int)cur().rows.size() - 1);
		{ // a pending "delete playlist" confirmation is cancelled as soon as the selection leaves that row
			View& cv = cur();
			if (cv.confirmDelete && (cv.sel < 0 || cv.sel >= (int)cv.rows.size() || cv.rows[cv.sel].kind != R_DELPLAYLIST)) {
				cv.confirmDelete = false;
				for (Row& r : cv.rows) if (r.kind == R_DELPLAYLIST) r.label = "Delete this playlist";
			}
		}
		if (d & BTN_RS_RIGHT) libJumpLetter(+1);
		if (d & BTN_RS_LEFT) libJumpLetter(-1);
		if (d & BTN_L3) libQueueSelected(false);
		if (d & BTN_A) libActivate(cur().sel);
		if (d & BTN_B) libBack(true);
		if (d & BTN_LEFT) libBack(false);
		if ((d & BTN_RIGHT) && cur().sel < (int)cur().rows.size() && rowOpensSomething(cur().rows[cur().sel].kind)) libActivate(cur().sel);
		if (d & BTN_X) libPlaySelected();
		if (d & BTN_Y) libClose();
		if (d & BTN_L) libShowMenu();
		if (d & BTN_R) libJumpMusicFolder();
		if (d & BTN_ZL) player::prev();
		if (d & BTN_ZR) player::next();
		if (d & BTN_R3) libAddToPlaylistPicker();
	}
	else {
		res.consumedButtons = BTN_A | BTN_ZL | BTN_ZR | BTN_UP | BTN_DOWN | BTN_LEFT | BTN_RIGHT | BTN_Y | BTN_R3 | BTN_L3 | (g_info.open ? BTN_B : 0u);
		if (d & BTN_A) doAction(T_PLAY);
		if (d & BTN_ZL) player::prev();
		if (d & BTN_ZR) player::next();
		if (d & BTN_LEFT) player::seekBy(-10);
		if (d & BTN_RIGHT) player::seekBy(10);
		const bool lyrPage = lyricsPageVisible();
		if (lyrPage) { // Up / Down scroll the lyrics instead of changing the volume
			res.consumedButtons |= BTN_B;
			float dir = 0.0f;
			if (h & (BTN_UP | BTN_LS_UP)) dir -= 1.0f;
			if (h & (BTN_DOWN | BTN_LS_DOWN)) dir += 1.0f;
			g_lyr.scroll = fminf(fmaxf(g_lyr.scroll + dir * 640.0f * dt, 0.0f), lyricsMaxScroll());
			if (d & BTN_B) lyricsShow(false);
		}
		if (!lyrPage && g_repVol.fire(d & (BTN_UP | BTN_DOWN), h & (BTN_UP | BTN_DOWN), dt, 0.3f, 0.09f)) {
			const int dir = (h & BTN_UP) ? +1 : -1;
			player::setVolume(player::volume() + dir * 8);
			char buf[48];
			snprintf(buf, sizeof(buf), "Volume %d%%", player::volume() * 100 / 128);
			showToast(buf);
		}
		if (d & BTN_R3) doAction(T_MODE);
		if (d & BTN_L3) toggleInfo();
		if ((d & BTN_B) && g_info.open) closeInfo();
		if (d & BTN_Y) { closeInfo(); libOpenNow(); }
	}

	// ---- lyrics
	lyricsRefresh();
	{
		const bool timedShown = lyricsTimedVisible(), pageShown = lyricsPageVisible();
		g_lyr.alpha += (((timedShown || pageShown) ? 1.0f : 0.0f) - g_lyr.alpha) * fminf(1.0f, dt * 8.0f);
		if (timedShown) {
			const bool running = player::isPlaying() || player::isPaused();
			const int idx = running ? lyrics::lineAt(g_lyr.data, player::position()) : -1;
			g_lyr.linePos += ((float)idx - g_lyr.linePos) * fminf(1.0f, dt * 9.0f);
		}
	}

	// ---- animation
	const float target = (g_hudTimer > 0.0f && !g_lib.open && !g_info.open && !lyricsPageVisible()) ? 1.0f : 0.0f;
	g_hudAlpha += (target - g_hudAlpha) * fminf(1.0f, dt * 9.0f);
	g_lib.slide += ((g_lib.open ? 1.0f : 0.0f) - g_lib.slide) * fminf(1.0f, dt * 12.0f);
	if (fabsf(g_lib.slide - (g_lib.open ? 1.0f : 0.0f)) < 0.003f) g_lib.slide = g_lib.open ? 1.0f : 0.0f;
	g_info.slide += ((g_info.open ? 1.0f : 0.0f) - g_info.slide) * fminf(1.0f, dt * 12.0f);
	if (fabsf(g_info.slide - (g_info.open ? 1.0f : 0.0f)) < 0.003f) g_info.slide = g_info.open ? 1.0f : 0.0f;
	if (g_info.open && player::currentPath() != g_info.forPath) infoLoad(); // another track started
	if (!g_info.open && g_info.slide == 0.0f && g_coverTex) infoFreeCover();  // panel is gone: release the cover
	if (!(g_lib.open && g_touchOwned && g_touchMoved && g_touchTarget == T_LIST)) {
		View& cv = cur();
		cv.scrollDisp += (cv.scroll - cv.scrollDisp) * fminf(1.0f, dt * 16.0f);
	}
	if (g_lib.open) libRefreshHome();

	g_prevTouching = in.touching;
	return res;
}

// ============================================================================ drawing
namespace {

void drawHud() {
	if (g_hudAlpha < 0.01f) return;
	g_alpha = g_hudAlpha;

	rrectGrad(0, HUD_TOP - 70, (float)g_w, g_h - (HUD_TOP - 70), 0, { 0, 0, 0, 0 }, { 0.01f, 0.02f, 0.04f, 0.92f });

	const bool has = player::hasTracks();
	const bool playing = player::isPlaying();
	const bool seekable = player::canSeek();
	const double dur = player::duration();

	// title + subtitle
	std::string title = has ? player::title() : "No music found";
	if (title.empty()) title = "Nothing playing";
	drawText(SZ_TITLE, 60, 494, title, C_WHITE, 940);
	const std::string sub = has ? player::subtitle() : "Press Y (or tap Library) to choose a music folder";
	drawText(SZ_NORMAL, 60, 494 + g_fontH[SZ_TITLE] + 2, sub, C_DIM, 940);

	// queue counter + play mode
	if (has) {
		char buf[48];
		snprintf(buf, sizeof(buf), "%d / %d", player::queueIndex() + 1, player::queueSize());
		drawText(SZ_SMALL, 1135, 500, buf, C_DIM, 0, RIGHT);
	}
	{
		static const Icon modeIcon[player::MODE_COUNT] = { IC_REPEAT, IC_SHUFFLE, IC_REPEAT1, IC_ONCE };
		const bool pr = pressed(T_MODE);
		if (pr) circle(1190, 532, 28, withA(C_WHITE, 0.15f));
		drawIcon(modeIcon[player::mode()], 1190, 532, 40,
			player::mode() == player::MODE_REPEAT_ALL ? C_DIM : C_ACCENT);
	}

	// progress bar
	const bool dragging = g_touchOwned && g_touching && g_touchTarget == T_SEEK && !g_lib.open;
	double pos = player::position();
	float frac = (dur > 0.0) ? (float)fminf(1.0, pos / dur) : 0.0f;
	if (dragging) { frac = g_seekFrac; pos = frac * dur; }
	rrect(BAR_X0, BAR_Y - 4, BAR_X1 - BAR_X0, 8, 4, withA(C_WHITE, 0.20f));
	if (frac > 0.0f) rrect(BAR_X0, BAR_Y - 4, fmaxf(8.0f, (BAR_X1 - BAR_X0) * frac), 8, 4, C_ACCENT);
	if (has && (dur > 0.0 || playing)) circle(BAR_X0 + (BAR_X1 - BAR_X0) * frac, BAR_Y, dragging ? 13.0f : 9.0f, C_WHITE);
	drawText(SZ_SMALL, BAR_X0 - 14, BAR_Y - g_fontH[SZ_SMALL] * 0.5f, fmtTime(pos), C_DIM, 0, RIGHT);
	drawText(SZ_SMALL, BAR_X1 + 14, BAR_Y - g_fontH[SZ_SMALL] * 0.5f, dur > 0.0 ? fmtTime(dur) : "--:--", C_DIM);

	// (i) chip: tap for track info (L3 on the controller)
	circle(1198, 587, 15, withA(C_WHITE, 0.12f));
	drawText(SZ_SMALL, 1198, 587 - g_fontH[SZ_SMALL] * 0.5f, "i", C_WHITE, 0, CENTER);

	// auto-change visualisation chip (equaliser bars; shows the interval when enabled)
	{
		const bool on = g_autoSecs > 0;
		const bool pr = g_touching && g_touchOwned && !g_lib.open && g_touchTarget == T_AUTO;
		circle(1130, 584, 15, withA(C_WHITE, pr ? 0.28f : (on ? 0.22f : 0.12f)));
		drawIcon(IC_VIZ, 1130, 584, 20, on ? C_ACCENT : C_DIM);
		if (on) {
			const std::string t = (g_autoSecs >= 120) ? std::to_string(g_autoSecs / 60) + "m" : std::to_string(g_autoSecs) + "s";
			drawText(SZ_SMALL, 1108, 584 - g_fontH[SZ_SMALL] * 0.5f, t, C_ACCENT, 0, RIGHT);
		}
	}

	// transport buttons
	struct B { Target t; float cx; Icon ic; float r, isz; bool enabled; };
	const B btns[] = {
		{ T_PREV, 470, IC_PREV, 30, 34, has },
		{ T_REW,  560, IC_REW,  30, 36, seekable },
		{ T_PLAY, 650, playing ? IC_PAUSE : IC_PLAY, 40, 46, true },
		{ T_FFW,  740, IC_FFW,  30, 36, seekable },
		{ T_NEXT, 830, IC_NEXT, 30, 34, has },
	};
	for (const B& b : btns) {
		const bool pr = pressed(b.t);
		const float k = b.enabled ? 1.0f : 0.35f;
		if (b.t == T_PLAY) {
			circle(b.cx, ROW_BTN_Y, b.r + (pr ? -2.0f : 0.0f), withA(C_ACCENT, pr ? 0.75f : 1.0f));
			drawIcon(b.ic, b.cx + (b.ic == IC_PLAY ? 2.0f : 0.0f), ROW_BTN_Y, b.isz, C_WHITE);
		}
		else {
			circle(b.cx, ROW_BTN_Y, b.r, withA(C_WHITE, (pr ? 0.28f : 0.10f) * k));
			drawIcon(b.ic, b.cx, ROW_BTN_Y, b.isz, withA(C_WHITE, k));
		}
	}

	// library button
	{
		const bool pr = pressed(T_LIB);
		rrect(50, ROW_BTN_Y - 28, 200, 56, 28, withA(C_WHITE, pr ? 0.28f : 0.10f));
		drawIcon(IC_FOLDER, 84, ROW_BTN_Y, 30, C_WHITE);
		drawText(SZ_NORMAL, 110, ROW_BTN_Y - g_fontH[SZ_NORMAL] * 0.5f, "Library", C_WHITE);
		drawText(SZ_SMALL, 232, ROW_BTN_Y - g_fontH[SZ_SMALL] * 0.5f, "Y", C_ACCENT, 0, RIGHT);
	}

	// volume
	{
		const float vf = player::volume() / 128.0f;
		drawIcon(IC_SPEAKER, 1038, ROW_BTN_Y, 34, C_DIM);
		rrect(VOL_X0, ROW_BTN_Y - 4, VOL_X1 - VOL_X0, 8, 4, withA(C_WHITE, 0.20f));
		if (vf > 0.0f) rrect(VOL_X0, ROW_BTN_Y - 4, fmaxf(8.0f, (VOL_X1 - VOL_X0) * vf), 8, 4, C_ACCENT);
		circle(VOL_X0 + (VOL_X1 - VOL_X0) * vf, ROW_BTN_Y, pressed(T_VOL) ? 12.0f : 8.0f, C_WHITE);
	}
}

void drawLibrary() {
	if (g_lib.slide < 0.01f) return;
	const float e = 1.0f - powf(1.0f - g_lib.slide, 3.0f);
	const float px = -(1.0f - e) * LIB_W;
	g_alpha = fminf(1.0f, e * 1.4f);
	View& v = cur();

	rrectGrad(px, 0, LIB_W, (float)g_h, 0, C_PANEL_TOP, C_PANEL_BOT);
	rrect(px + LIB_W - 2, 0, 2, (float)g_h, 0, withA(C_ACCENT, 0.8f));

	// rows
	const std::string& playingPath = player::currentPath();
	const bool trackActive = player::isPlaying() || player::isPaused();
	const Color folderYellow = { 1.0f, 0.82f, 0.35f, 1.0f };
	for (size_t i = 0; i < v.rows.size(); i++) {
		const float y = listTop() + i * ROW_H - v.scrollDisp;
		if (y + ROW_H < listTop() - 2 || y > listBottom() + 2) continue;
		const Row& r = v.rows[i];
		const bool sel = ((int)i == v.sel);
		const bool isMusicFolder = (r.kind == R_DIR && r.path == player::musicFolder()) ||
			(r.kind == R_SETDIR && g_lib.dir == player::musicFolder());
		const bool isPlaying = ((r.kind == R_FILE || r.kind == R_TRACK) && trackActive && r.path == playingPath);

		if (sel) {
			rrect(px + 10, y + 3, LIB_W - 26, ROW_H - 6, 10, withA(C_ACCENT, 0.28f));
			rrect(px + 10, y + 10, 4, ROW_H - 20, 2, C_ACCENT);
		}
		Icon ic = IC_NOTE;
		Color iconCol = C_WHITE, textCol = C_WHITE;
		switch (r.kind) {
		case R_UP: ic = IC_UP; iconCol = textCol = C_DIM; break;
		case R_BACK: ic = IC_BACK; iconCol = textCol = C_DIM; break;
		case R_PLAYDIR: case R_PLAYALL: ic = IC_PLAY; iconCol = textCol = C_ACCENT; break;
		case R_SAVEQUEUE: case R_NEWPLAYLIST: ic = IC_PLAYLIST; iconCol = textCol = C_ACCENT; break;
		case R_PICKPLAYLIST: ic = IC_PLAYLIST; iconCol = C_ACCENT; break;
		case R_RENAMEPLAYLIST: ic = IC_PLAYLIST; iconCol = textCol = C_ACCENT; break;
		case R_DELPLAYLIST: { const Color red = { 1.0f, 0.45f, 0.45f, 1.0f }; ic = IC_CLOSE; iconCol = red; textCol = red; break; }
		case R_SETDIR: ic = IC_STAR; iconCol = textCol = isMusicFolder ? C_ACCENT : C_DIM; break;
		case R_DIR: ic = isMusicFolder ? IC_STAR : IC_FOLDER; iconCol = isMusicFolder ? C_ACCENT : folderYellow; break;
		case R_FILE: case R_TRACK: ic = isPlaying ? IC_PLAY : IC_NOTE; iconCol = textCol = isPlaying ? C_ACCENT : C_WHITE; break;
		case R_HOME_FOLDERS: ic = IC_FOLDER; iconCol = folderYellow; break;
		case R_HOME_ALBUMS: case R_ALBUM: ic = IC_ALBUM; iconCol = C_ACCENT; break;
		case R_HOME_ARTISTS: case R_ARTIST: ic = IC_ARTIST; iconCol = C_ACCENT; break;
		case R_HOME_GENRES: case R_GENRE: ic = IC_GENRE; iconCol = C_ACCENT; break;
		case R_HOME_PLAYLISTS: case R_PLAYLIST: ic = IC_PLAYLIST; iconCol = C_ACCENT; break;
		case R_HOME_ALL: ic = IC_NOTE; iconCol = C_ACCENT; break;
		case R_HOME_AUTO: ic = IC_VIZ; iconCol = g_autoSecs ? C_ACCENT : C_DIM; break;
		case R_HOME_SLEEPACT: ic = IC_CLOSE; iconCol = C_DIM; break;
		case R_HOME_SLEEP: ic = IC_PAUSE; iconCol = player::sleepActive() ? C_ACCENT : C_DIM; break;
		case R_HOME_RESUME: ic = IC_PLAY; iconCol = C_DIM; break;
		case R_HOME_RESCAN: ic = IC_REPEAT; iconCol = C_DIM; textCol = C_DIM; break;
		}
		if (sel && textCol.r == C_DIM.r) textCol = C_WHITE;
		drawIcon(ic, px + 52, y + ROW_H * 0.5f, 30, iconCol);

		float subW = 0;
		if (!r.sub.empty()) { // dim text on the right
			subW = fminf(textWidth(SZ_SMALL, r.sub), 230.0f);
			drawText(SZ_SMALL, px + LIB_W - 40, y + (ROW_H - g_fontH[SZ_SMALL]) * 0.5f, r.sub, C_DIM, 230, RIGHT);
		}
		drawText(SZ_NORMAL, px + 84, y + (ROW_H - g_fontH[SZ_NORMAL]) * 0.5f, r.label, textCol, LIB_W - 84 - 40 - (subW > 0 ? subW + 18 : 0));
	}
	if (v.empty) {
		const float y = listTop() + v.rows.size() * ROW_H - v.scrollDisp + 16;
		const int sz = (textWidth(SZ_NORMAL, v.emptyMsg) <= LIB_W - 60) ? SZ_NORMAL : SZ_SMALL;
		if (y < listBottom()) drawText(sz, px + LIB_W * 0.5f, y, v.emptyMsg, C_DIM, LIB_W - 60, CENTER);
	}

	// scrollbar
	if (maxScroll(v) > 0.0f) {
		const float total = v.rows.size() * ROW_H, lh = listHeight();
		const float thumbH = fmaxf(36.0f, lh * lh / total);
		const float thumbY = listTop() + (v.scrollDisp / maxScroll(v)) * (lh - thumbH);
		rrect(px + LIB_W - 10, thumbY, 4, thumbH, 2, withA(C_WHITE, 0.30f));
	}

	// header + footer cover partially scrolled rows
	const Color bar = { 0.015f, 0.025f, 0.05f, 0.97f };
	rrect(px, 0, LIB_W - 2, LIB_HEAD, 0, bar);
	rrect(px, listBottom(), LIB_W - 2, LIB_FOOT + 1.0f, 0, bar);
	rrect(px + 16, LIB_HEAD - 1, LIB_W - 36, 1, 0, withA(C_WHITE, 0.12f));

	std::string title = v.title, subtitle = v.subtitle;
	bool tail = false;
	if (g_lib.mode == M_FOLDERS) {
		title = "Folders";
		subtitle = g_lib.dir;
		if (g_lib.dir == player::musicFolder()) subtitle += "   (music folder)";
		tail = true;
	}
	drawText(SZ_TITLE, px + 36, 6, title, C_WHITE, LIB_W - 36 - 190);
	drawText(SZ_SMALL, px + 38, 60, subtitle, C_DIM, LIB_W - 250, LEFT, tail);

	const bool pressedHdr = g_touching && g_touchOwned && g_lib.open;
	circle(px + LIB_W - 172, 50, 26, withA(C_WHITE, (pressedHdr && g_touchTarget == T_MENU) ? 0.28f : 0.10f));
	drawIcon(IC_PLAYLIST, px + LIB_W - 172, 50, 28, C_WHITE);
	circle(px + LIB_W - 108, 50, 26, withA(C_WHITE, (pressedHdr && g_touchTarget == T_HOME) ? 0.28f : 0.10f));
	drawIcon(IC_STAR, px + LIB_W - 108, 50, 28, C_ACCENT);
	circle(px + LIB_W - 44, 50, 26, withA(C_WHITE, (pressedHdr && g_touchTarget == T_CLOSE) ? 0.28f : 0.10f));
	drawIcon(IC_CLOSE, px + LIB_W - 44, 50, 26, C_WHITE);

	// footer hints
	struct Hint { const char* key; const char* label; };
	const Hint hints[] = { {"A", "Open"}, {"B", "Back"}, {"X", "Play"}, {"Y", "Close"}, {"L", "Menu"}, {"R", "Music folder"} };
	float hx = px + 26;
	const float hy = listBottom() + (LIB_FOOT - g_fontH[SZ_SMALL]) * 0.5f;
	for (const Hint& hnt : hints) {
		hx += drawText(SZ_SMALL, hx, hy, hnt.key, C_ACCENT) + 6;
		hx += drawText(SZ_SMALL, hx, hy, hnt.label, C_DIM) + 16;
	}
}

std::string encodeUtf8(const std::vector<uint32_t>& cps) {
	std::string out;
	for (uint32_t cp : cps) {
		if (cp < 0x80) out += (char)cp;
		else if (cp < 0x800) { out += (char)(0xC0 | (cp >> 6)); out += (char)(0x80 | (cp & 0x3F)); }
		else if (cp < 0x10000) { out += (char)(0xE0 | (cp >> 12)); out += (char)(0x80 | ((cp >> 6) & 0x3F)); out += (char)(0x80 | (cp & 0x3F)); }
		else { out += (char)(0xF0 | (cp >> 18)); out += (char)(0x80 | ((cp >> 12) & 0x3F)); out += (char)(0x80 | ((cp >> 6) & 0x3F)); out += (char)(0x80 | (cp & 0x3F)); }
	}
	return out;
}

// Word-wraps text into at most maxLines lines (the last one gets "..." if text is left over). Returns the height used.
float drawWrapped(int sz, float x, float y, float maxW, int maxLines, const std::string& text, Color c) {
	if (text.empty() || g_faces[sz].empty()) return 0;
	const std::vector<uint32_t> cps = decodeUtf8(text);
	std::vector<std::vector<uint32_t>> lines;
	std::vector<uint32_t> cur;
	float curW = 0;
	const float spaceW = (float)glyph(sz, ' ').adv;
	size_t i = 0;
	while (i < cps.size()) {
		size_t j = i;
		while (j < cps.size() && cps[j] != ' ') j++;           // word = [i, j)
		const float ww = cpsWidth(sz, cps, i, j);
		if (!cur.empty() && curW + spaceW + ww > maxW) { lines.push_back(cur); cur.clear(); curW = 0; }
		if (cur.empty() && ww > maxW) {                        // one very long word: break it up
			for (size_t k = i; k < j; k++) {
				const float cw = (float)glyph(sz, cps[k]).adv;
				if (curW + cw > maxW && !cur.empty()) { lines.push_back(cur); cur.clear(); curW = 0; }
				cur.push_back(cps[k]);
				curW += cw;
			}
		}
		else {
			if (!cur.empty()) { cur.push_back(' '); curW += spaceW; }
			cur.insert(cur.end(), cps.begin() + i, cps.begin() + j);
			curW += ww;
		}
		i = j;
		while (i < cps.size() && cps[i] == ' ') i++;
	}
	if (!cur.empty()) lines.push_back(cur);
	const bool truncated = (int)lines.size() > maxLines;
	if (truncated) lines.resize(maxLines);
	float yy = y;
	for (size_t l = 0; l < lines.size(); l++) {
		std::string line = encodeUtf8(lines[l]);
		if (truncated && l + 1 == lines.size()) line += "...";
		drawText(sz, x, yy, line, c, maxW);
		yy += g_fontH[sz];
	}
	return yy - y;
}

std::string fmtSize(uint64_t b) {
	char buf[32];
	if (b >= 1024ull * 1024 * 1024) snprintf(buf, sizeof(buf), "%.2f GB", b / 1073741824.0);
	else if (b >= 1024ull * 1024) snprintf(buf, sizeof(buf), "%.1f MB", b / 1048576.0);
	else snprintf(buf, sizeof(buf), "%.0f KB", b / 1024.0);
	return buf;
}

void drawInfo() {
	if (g_info.slide < 0.01f) return;
	const float e = 1.0f - powf(1.0f - g_info.slide, 3.0f);
	const float px = g_w - INFO_W * e;
	g_alpha = fminf(1.0f, e * 1.4f);
	const tags::TrackTags& t = g_info.t;

	rrectGrad(px, 0, INFO_W, (float)g_h, 0, C_PANEL_TOP, C_PANEL_BOT);
	rrect(px, 0, 2, (float)g_h, 0, withA(C_ACCENT, 0.8f));

	// header
	drawText(SZ_TITLE, px + 36, 6, "Track info", C_WHITE);
	drawText(SZ_SMALL, px + 38, 60, player::baseName(g_info.forPath), C_DIM, INFO_W - 160);
	const bool closeP = g_touching && g_touchOwned && g_info.open && g_touchTarget == T_CLOSE;
	circle(px + INFO_W - 44, 50, 26, withA(C_WHITE, closeP ? 0.28f : 0.10f));
	drawIcon(IC_CLOSE, px + INFO_W - 44, 50, 26, C_WHITE);
	rrect(px + 16, 99, INFO_W - 32, 1, 0, withA(C_WHITE, 0.12f));

	// cover art (or a placeholder)
	const float cx0 = px + 36, cy0 = 122, cs = 220;
	if (g_coverTex && g_info.coverW > 0) {
		const float sc = cs / (float)std::max(g_info.coverW, g_info.coverH);
		const float w = g_info.coverW * sc, h = g_info.coverH * sc;
		coverQuad(cx0 + (cs - w) * 0.5f, cy0 + (cs - h) * 0.5f, w, h, 10);
	}
	else {
		rrect(cx0, cy0, cs, cs, 12, withA(C_WHITE, 0.06f));
		drawIcon(IC_NOTE, cx0 + cs * 0.5f, cy0 + cs * 0.5f, 96, withA(C_WHITE, 0.25f));
	}

	// headline: title, artist, album
	const std::string title = !t.title.empty() ? t.title : player::title();
	const float hx = cx0 + cs + 28, hw = INFO_W - (hx - px) - 30;
	float hy = cy0;
	hy += drawWrapped(SZ_TITLE, hx, hy, hw, 2, title, C_WHITE) + 8;
	if (!t.artist.empty()) hy += drawWrapped(SZ_NORMAL, hx, hy, hw, 1, t.artist, C_ACCENT) + 2;
	if (!t.album.empty()) drawWrapped(SZ_NORMAL, hx, hy, hw, 1, t.album, C_DIM);

	// details: tags on the left, file info on the right
	struct R { std::string k, v; };
	std::vector<R> left, right;
	auto add = [](std::vector<R>& v, const char* k, const std::string& val) { if (!val.empty()) v.push_back({ k, val }); };
	add(left, "Album artist", t.albumArtist);
	add(left, "Composer", t.composer);
	add(left, "Track", t.track);
	add(left, "Disc", t.disc);
	add(left, "Year", t.year);
	add(left, "Genre", t.genre);
	add(left, "Comment", t.comment);

	char buf[64];
	add(right, "Format", t.format);
	add(right, "Tags", t.tagType.empty() ? "none" : t.tagType);
	if (t.bitrateKbps > 0) {
		snprintf(buf, sizeof(buf), t.vbr ? "VBR avg %d kbps" : "%d kbps", t.bitrateKbps);
		add(right, "Bitrate", buf);
	}
	if (t.sampleRate > 0) {
		snprintf(buf, sizeof(buf), "%g kHz", t.sampleRate / 1000.0);
		add(right, "Sample rate", buf);
	}
	if (t.channels > 0) {
		if (t.channels == 1) add(right, "Channels", "Mono");
		else if (t.channels == 2) add(right, "Channels", "Stereo");
		else { snprintf(buf, sizeof(buf), "%d channels", t.channels); add(right, "Channels", buf); }
	}
	if (t.bitsPerSample > 0) { snprintf(buf, sizeof(buf), "%d-bit", t.bitsPerSample); add(right, "Bit depth", buf); }
	{
		const double dur = player::duration();
		const bool active = (g_info.forPath == player::currentPath()) && (player::isPlaying() || player::isPaused());
		std::string len = dur > 0.0 ? fmtTime(dur) : "--:--";
		if (active) len = fmtTime(player::position()) + " / " + len;
		add(right, "Length", len);
	}
	if (t.fileSize > 0) add(right, "Size", fmtSize(t.fileSize));

	const float colL = px + 36, colR = px + 396, labelW = 132, rowH = 29, top = 396;
	drawText(SZ_SMALL, colL, 364, "TAGS", C_ACCENT);
	drawText(SZ_SMALL, colR, 364, "FILE", C_ACCENT);
	rrect(colL, 390, 340, 1, 0, withA(C_WHITE, 0.10f));
	rrect(colR, 390, 330, 1, 0, withA(C_WHITE, 0.10f));
	if (left.empty()) drawText(SZ_SMALL, colL, top + 4, "No tags in this file", C_DIM);
	for (size_t i = 0; i < left.size(); i++) {
		const float y = top + 4 + i * rowH;
		drawText(SZ_SMALL, colL, y, left[i].k, C_DIM);
		drawText(SZ_SMALL, colL + labelW, y, left[i].v, C_WHITE, 340 - labelW);
	}
	for (size_t i = 0; i < right.size(); i++) {
		const float y = top + 4 + i * rowH;
		drawText(SZ_SMALL, colR, y, right[i].k, C_DIM);
		drawText(SZ_SMALL, colR + labelW, y, right[i].v, C_WHITE, 330 - labelW);
	}
	drawText(SZ_SMALL, colL, 636, "Path", C_DIM);
	drawText(SZ_SMALL, colL + 62, 636, g_info.forPath, C_WHITE, INFO_W - 36 - 62 - 30, LEFT, true);

	// footer
	const Color bar = { 0.015f, 0.025f, 0.05f, 0.97f };
	rrect(px + 2, g_h - 56.0f, INFO_W - 2, 56, 0, bar);
	struct Hint { const char* key; const char* label; };
	const Hint hints[] = { {"L3 / B", "Close"}, {"A", "Play/Pause"}, {"ZL / ZR", "Previous / Next"} };
	float fx = px + 36;
	const float fy = g_h - 56.0f + (56.0f - g_fontH[SZ_SMALL]) * 0.5f;
	for (const Hint& hnt : hints) {
		fx += drawText(SZ_SMALL, fx, fy, hnt.key, C_ACCENT) + 8;
		fx += drawText(SZ_SMALL, fx, fy, hnt.label, C_DIM) + 24;
	}
}

void drawToast() {
	if (g_toastTimer <= 0.0f) return;
	g_alpha = fminf(1.0f, g_toastTimer / 0.4f);
	const float maxW = 900.0f;
	const float tw = fminf(maxW, textWidth(SZ_NORMAL, g_toast));
	const float x = g_lib.open ? LIB_W + 30.0f : 36.0f;
	rrect(x, 30, tw + 56, 48, 24, { 0.02f, 0.04f, 0.08f, 0.88f });
	circle(x + 24, 54, 5, C_ACCENT);
	drawText(SZ_NORMAL, x + 42, 30 + (48 - g_fontH[SZ_NORMAL]) * 0.5f, g_toast, C_WHITE, maxW);
}

} // namespace

void draw() {
	if (!g_ready) return;
	g_v.clear();
	glActiveTexture(GL_TEXTURE0);
	glBindTexture(GL_TEXTURE_2D, g_atlasTex);
	drawLyrics();
	drawHud();
	drawLibrary();
	drawInfo();
	drawToast();
	g_alpha = 1.0f;
	flush();
}

} // namespace ui
